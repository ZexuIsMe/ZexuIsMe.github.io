<!-- 目录组件 -->
<div class="lg:w-1/3 hidden lg:block">
    <div id="toc-container" class="pixel-card bg-dark p-6 sticky" style="top: 7rem;">
        <h3 class="text-xl font-pixel mb-4 text-primary border-b border-gray-700 pb-2">文章目录</h3>
        <div id="toc" class="toc-nav">
            <!-- 目录内容将通过JavaScript动态生成 -->
        </div>
    </div>
</div>

<script>
// 生成文章目录
const generateTOC = function() {
    const tocContainer = document.getElementById('toc');
    const headings = document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4, .markdown-body h5, .markdown-body h6');
    
    if (!tocContainer || headings.length === 0) {
        tocContainer.innerHTML = '<p class="text-gray-500">文章无标题</p>';
        return;
    }
    
    // 清空目录容器
    tocContainer.innerHTML = '';
    
    // 创建目录列表
    const tocList = document.createElement('ul');
    tocList.className = 'toc-list';
    
    // 遍历所有标题
    headings.forEach(heading => {
        // 为标题添加ID（如果没有）
        if (!heading.id) {
            heading.id = 'heading-' + Math.random().toString(36).substr(2, 9);
        }
        
        // 创建目录项
        const tocItem = document.createElement('li');
        tocItem.className = 'toc-item';
        tocItem.style.marginLeft = `${(heading.tagName.charAt(1) - 1) * 16}px`;
        
        // 创建目录链接
        const tocLink = document.createElement('a');
        tocLink.className = 'toc-link';
        tocLink.href = '#' + heading.id;
        tocLink.textContent = heading.textContent;
        tocLink.style.display = 'block';
        tocLink.style.padding = '4px 0';
        tocLink.style.color = 'var(--color-text-primary)';
        tocLink.style.textDecoration = 'none';
        tocLink.style.transition = 'all 0.2s ease';
        tocLink.style.borderRadius = '4px';
        tocLink.style.maxWidth = '100%';
        tocLink.style.overflow = 'hidden';
        tocLink.style.textOverflow = 'ellipsis';
        tocLink.style.whiteSpace = 'nowrap';
        tocLink.title = heading.textContent;
        
        // 添加悬停效果
        tocLink.addEventListener('mouseenter', function() {
            this.style.color = 'var(--color-text-accent)';
            this.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
        });
        
        tocLink.addEventListener('mouseleave', function() {
            if (!this.classList.contains('active')) {
                this.style.color = 'var(--color-text-primary)';
                this.style.backgroundColor = 'transparent';
            }
        });
        
        // 点击目录项时平滑滚动到对应标题
        tocLink.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('href').substring(1);
            const targetElement = document.getElementById(targetId);
            
            if (targetElement) {
                window.scrollTo({
                    top: targetElement.offsetTop - 100,
                    behavior: 'smooth'
                });
            }
        });
        
        tocItem.appendChild(tocLink);
        tocList.appendChild(tocItem);
    });
    
    tocContainer.appendChild(tocList);
};

// 高亮当前阅读位置的目录项
const highlightActiveTOC = function() {
    const headings = document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4, .markdown-body h5, .markdown-body h6');
    const tocLinks = document.querySelectorAll('.toc-link');
    
    let currentHeading = null;
    
    headings.forEach(heading => {
        const rect = heading.getBoundingClientRect();
        if (rect.top <= 150) {
            currentHeading = heading;
        }
    });
    
    tocLinks.forEach(link => {
        link.classList.remove('active');
        link.style.color = 'var(--color-text-primary)';
        link.style.backgroundColor = 'transparent';
        link.style.borderLeft = 'none';
        link.style.paddingLeft = '0';
    });
    
    if (currentHeading) {
        const activeLink = document.querySelector(`.toc-link[href="#${currentHeading.id}"]`);
        if (activeLink) {
            activeLink.classList.add('active');
            activeLink.style.color = 'var(--color-text-accent)';
            activeLink.style.backgroundColor = 'rgba(255, 255, 255, 0.05)';
            activeLink.style.borderLeft = '3px solid var(--color-text-accent)';
            activeLink.style.paddingLeft = '8px';
        }
    }
};

document.addEventListener('DOMContentLoaded', () => {
    generateTOC();
    highlightActiveTOC();
});

window.addEventListener('scroll', highlightActiveTOC);
</script>
