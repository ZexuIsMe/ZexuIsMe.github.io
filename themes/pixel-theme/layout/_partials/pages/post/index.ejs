<!-- 页面：文章详情 -->
<section id="post-detail" class="py-16 px-4">
    <!-- Loading动画 -->
    <%- partial('../../component/loading') %>
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-8">
        <!-- 文章内容区域 -->
        <div class="lg:w-full">
            <!-- 文章头部信息 -->
            <div id="post-header" class="mb-12 text-center">
                <h1 class="text-3xl md:text-4xl font-pixel mb-6 text-black"><%= page.title %></h1>
                <div id="post-meta" class="flex flex-wrap justify-center items-center gap-4 text-sm text-gray-600">
                    <!-- 文章日期 -->
                    <span class="flex items-center">
                        <i class="fas fa-calendar mr-2"></i>
                        <%= date(page.date, config.date_format) %>
                    </span>
                    <!-- 文章作者 -->
                    <span class="flex items-center">
                        <i class="fas fa-user mr-2"></i>
                        <%= page.author || config.author %>
                    </span>
                    <!-- 文章分类 -->
                    <% if (page.categories && page.categories.length) { %>
                        <span class="flex items-center">
                            <i class="fas fa-folder mr-2"></i>
                            <% page.categories.forEach(function(category, index) { %>
                                <span
                                    class="hover:text-secondary transition-colors" 
                                    onclick="handleTagClick('category', '<%= category.name %>', '<%- url_for(category.path) %>')"
                                    style="cursor: pointer;"
                                >
                                    <%= category.name %>
                                </span>
                                <% if (index < page.categories.length - 1) { %>, <% } %>
                            <% }) %>
                        </span>
                    <% } %>
                    <!-- 文章标签 -->
                    <% if (page.tags && page.tags.length) { %>
                        <span class="flex items-center">
                            <i class="fas fa-tags mr-2"></i>
                            <% page.tags.forEach(function(tag, index) { %>
                                <span
                                    class="hover:text-black transition-colors" 
                                    onclick="handleTagClick('tag', '<%= tag.name %>', '<%- url_for(tag.path) %>')"
                                    style="cursor: pointer;"
                                >
                                    <%= tag.name %>
                                </span>
                                <% if (index < page.tags.length - 1) { %>, <% } %>
                            <% }) %>
                        </span>
                    <% } %>
                </div>
            </div>

            <!-- 文章内容 -->
            <article class="markdown-body pixel-card bg-dark p-6 mb-12">
                <%- page.content %>
                
                <!-- 版权声明 -->
                <% if (theme.article.show_copyright && (page.author || config.author) === theme.author) { %>
                    <div class="copyright-notice mt-12 pt-6 border-t border-gray-700">
                        <p class="text-sm text-gray-500">
                            © <%= new Date().getFullYear() %> <%= config.author %>. <%= theme.article.copyright %>
                        </p>
                        <p class="text-sm text-gray-500 mt-2">
                            <%= theme.article.copyright_subtext %>
                        </p>
                    </div>
                <% } %>
            </article>

            <!-- 文章底部 -->
            <div class="flex justify-between items-center mt-8">
                <!-- 上一篇/下一篇导航 -->
                <div class="flex flex-col gap-4 w-full">
                    <% if (page.prev) { %>
                        <a href="<%= url_for(page.prev.path) %>" class="pixel-button w-fit hover:bg-secondary transition-colors">
                            <i class="fas fa-arrow-left mr-2"></i> <%= theme.article.pre_link %>
                        </a>
                    <% } %>
                    <% if (page.next) { %>
                        <a href="<%= url_for(page.next.path) %>" class="pixel-button w-fit ml-auto hover:bg-gray-800 transition-colors">
                            <%= theme.article.next_link %> <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- 评论区（如果启用） -->
            <% if (config.disqus_shortname && page.comments !== false) { %>
                <div class="mt-16">
                    <div id="disqus_thread"></div>
                    <script>
                        var disqus_config = function () {
                            this.page.url = '<%= page.permalink %>';
                            this.page.identifier = '<%= page.path %>';
                        };
                        (function() {
                            var d = document, s = d.createElement('script');
                            s.src = '//<%= config.disqus_shortname %>.disqus.com/embed.js';
                            s.setAttribute('data-timestamp', +new Date());
                            (d.head || d.body).appendChild(s);
                        })();
                    </script>
                    <noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
                </div>
            <% } %>
        </div>
    </div>
</section>

<script>

// 文章详情页：取消导航菜单选中状态
const setNavSelect = function() {
    const STORAGE_KEY = 'activeNavLink';
    
    // 清除本地存储中的导航选中状态
    localStorage.removeItem(STORAGE_KEY);
    
    // 移除所有导航链接的active类
    document.querySelectorAll('.nav-link').forEach(link => {
        link.classList.remove('active');
    });
    document.querySelectorAll('#mobile-menu a').forEach(link => {
        link.classList.remove('active');
    });
}

// 为代码块添加语言显示、复制和展开/折叠功能
const handleCodeBox = function() {
    const codeBlocks = document.querySelectorAll('.markdown-body pre');
    
    codeBlocks.forEach(codeBlock => {
        // 检测代码语言
        const codeElement = codeBlock.querySelector('code');
        if (!codeElement) return;
        
        const classList = codeElement.className;
        let language = 'Code';
        
        // 从class中提取语言信息
        if (classList) {
            const languageMatch = classList.match(/hljs (\w+)/);
            if (languageMatch) {
                language = languageMatch[1];
            }
        }
        
        // 创建代码块头部
        const header = document.createElement('div');
        header.className = 'code-header';
        
        // 添加语言标签
        const languageLabel = document.createElement('span');
        languageLabel.className = 'code-language';
        languageLabel.textContent = language;
        header.appendChild(languageLabel);
        
        // 添加复制按钮
        const copyButton = document.createElement('button');
        copyButton.className = 'copy-button';
        copyButton.innerHTML = '<i class="fas fa-copy"></i> 复制';
        copyButton.setAttribute('title', '复制代码');
        
        // 添加展开/折叠按钮
        const toggleButton = document.createElement('button');
        toggleButton.className = 'toggle-button';
        toggleButton.innerHTML = '<i class="fas fa-chevron-up"></i>';
        toggleButton.setAttribute('title', '折叠代码');
        
        // 复制功能
        copyButton.addEventListener('click', async function() {
            const code = codeElement.textContent;
            
            try {
                await navigator.clipboard.writeText(code);
                
                // 显示复制成功状态
                copyButton.classList.add('copied');
                copyButton.innerHTML = '<i class="fas fa-check"></i> 已复制';
                
                // 2秒后恢复原状
                setTimeout(() => {
                    copyButton.classList.remove('copied');
                    copyButton.innerHTML = '<i class="fas fa-copy"></i> 复制';
                }, 2000);
            } catch (err) {
                console.error('复制失败:', err);
                // 降级方案：使用传统复制方法
                const textarea = document.createElement('textarea');
                textarea.value = code;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                try {
                    document.execCommand('copy');
                    copyButton.classList.add('copied');
                    copyButton.innerHTML = '<i class="fas fa-check"></i> 已复制';
                    setTimeout(() => {
                        copyButton.classList.remove('copied');
                        copyButton.innerHTML = '<i class="fas fa-copy"></i> 复制';
                    }, 2000);
                } catch (e) {
                    console.error('降级复制也失败:', e);
                }
                document.body.removeChild(textarea);
            }
        });
        
        header.appendChild(copyButton);
        header.appendChild(toggleButton);
        
        // 展开/折叠功能
        let isExpanded = true;
        const codeContent = codeElement.parentElement;
        
        // 为代码元素添加过渡效果
        codeElement.style.transition = 'all 0.3s ease';
        codeElement.style.maxHeight = '10000px';
        codeElement.style.overflow = 'hidden';
        
        toggleButton.addEventListener('click', function() {
            isExpanded = !isExpanded;
            
            if (isExpanded) {
                // 展开代码
                codeElement.style.maxHeight = '10000px';
                codeElement.style.opacity = '1';
                toggleButton.innerHTML = '<i class="fas fa-chevron-up"></i>';
                toggleButton.setAttribute('title', '折叠代码');
            } else {
                // 折叠代码
                codeElement.style.maxHeight = '0';
                codeElement.style.opacity = '0';
                toggleButton.innerHTML = '<i class="fas fa-chevron-down"></i>';
                toggleButton.setAttribute('title', '展开代码');
            }
        });
        
        // 将头部插入到代码块前面
        codeBlock.insertBefore(header, codeBlock.firstChild);
    });
}

const handleTagClick = function(type, name, path) {
    const aLink = document.getElementById('global-link');
    if (!aLink) {
        console.error("<%= theme.article.link_404 %>");
        return;
    }
    aLink.href = path;
    localStorage.setItem('activeNavLink', aLink.href);
    aLink.click();
}

// 为文章中的图片添加点击放大效果
const handleImageClick = function() {
    // 创建图片预览模态框
    const modal = document.createElement('div');
    modal.id = 'image-preview-modal';
    modal.className = 'fixed inset-0 z-50 flex items-center justify-center hidden';
    modal.innerHTML = `
        <div class="absolute inset-0 bg-black bg-opacity-80 modal-overlay"></div>
        <div class="relative bg-white p-4 rounded-lg max-w-4xl max-h-[90vh] w-full mx-4 flex items-center justify-center modal-content">
            <img id="preview-image" src="" alt="预览图片" class="max-w-full max-h-[85vh] object-contain">
        </div>
    `;
    document.body.appendChild(modal);

    // 获取所有文章中的图片
    const images = document.querySelectorAll('.markdown-body img');
    
    images.forEach(image => {
        // 添加点击事件
        image.addEventListener('click', function() {
            const imgSrc = this.src;
            const previewImg = document.getElementById('preview-image');
            
            if (previewImg) {
                previewImg.src = imgSrc;
                // 显示模态框
                modal.classList.remove('hidden');
                // 添加过渡效果
                setTimeout(() => {
                    modal.querySelector('.modal-overlay').style.opacity = '1';
                    modal.querySelector('.modal-content').style.transform = 'scale(1)';
                }, 10);
            }
        });
    });

    // 点击遮罩关闭模态框
    modal.addEventListener('click', function(e) {
        if (e.target === modal || e.target.classList.contains('modal-overlay')) {
            // 添加过渡效果
            modal.querySelector('.modal-overlay').style.opacity = '0';
            modal.querySelector('.modal-content').style.transform = 'scale(0.9)';
            
            // 延迟后隐藏模态框
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    });
}

// 为表格添加容器，使其在溢出时显示滚动条
const handleTables = function() {
    const tables = document.querySelectorAll('.markdown-body table');
    
    tables.forEach(table => {
        // 检查表格是否已经有容器
        if (!table.parentElement.classList.contains('table-container')) {
            // 创建容器
            const container = document.createElement('div');
            container.className = 'table-container';
            
            // 将表格移动到容器中
            table.parentNode.insertBefore(container, table);
            container.appendChild(table);
        }
    });
};

document.addEventListener('DOMContentLoaded', () => {
    setNavSelect();
    handleCodeBox();
    handleImageClick();
    handleTables();
});
</script>

