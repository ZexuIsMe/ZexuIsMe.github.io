<%
    const {
        table_headers: headers, 
        no_posts_found: noPostsFound, 
        check: checkText,
        title: titleText,
    } = theme.archives;

    const { posts: postItems } = page;
%>
<section class="archive min-h-screen py-12">
    <div class="container mx-auto px-4">

        <h1 class="text-4xl font-bold text-center mb-12 text-white"><%= titleText %></h1>

        <!-- 搜索框 -->
        <%- partial('search') %>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <% headers.forEach(item => { %>
                            <th><%= item %></th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <% if (postItems && postItems.length > 0) { %>
                        <% postItems.each(function(post, index) { %>
                            <tr>
                                <td><a href="<%= url_for(post.path) %>"><%= post.title %></a></td>
                                <td>
                                    <div class="flex">
                                        <% if (post.categories && post.categories.length > 0) { %>
                                            <% post.categories.each(function(category) { %>
                                                <span onclick="handleCategoryClick('category', '<%= category.name %>', '<%= url_for(category.path) %>')">
                                                    <%= category.name %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span>--</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <div class="flex">
                                        <% if (post.tags && post.tags.length > 0) { %>
                                            <% post.tags.each(function(tag) { %>
                                                <span onclick="handleCategoryClick('tag', '<%= tag.name %>', '<%= url_for(tag.path) %>')">
                                                    <%= tag.name %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span>--</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td><%= date(post.date, 'YYYY-MM-DD') %></td>
                                <td><%= date(post.updated, 'YYYY-MM-DD') %></td>
                                <td><a href="<%= url_for(post.path) %>"><%= checkText %></a></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr class="empty-row">
                            <!-- 暂无文章提示 -->
                            <td colspan="6"><%= noPostsFound %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        
        <!-- 分页组件 -->
        <%- partial('../../component/pagination') %>
    </div>
</section>

<style>
    .highlight-column {
        background-color: rgba(59, 130, 246, 0.15) !important;
        font-weight: 500;
    }
    
    .table-container table thead tr th.highlight-column {
        background-color: rgba(59, 130, 246, 0.3) !important;
    }
    
    /* 创建时间、更新时间、操作列居中 */
    .table-container table tbody tr td:nth-child(4),
    .table-container table tbody tr td:nth-child(5),
    .table-container table tbody tr td:nth-child(6) {
        text-align: center;
    }
    
    .table-container table thead tr th:nth-child(4),
    .table-container table thead tr th:nth-child(5),
    .table-container table thead tr th:nth-child(6) {
        text-align: center;
    }
</style>

<script>
    // 处理分类点击事件
    const handleCategoryClick = (type, name, path) => {
        const options = localStorage.getItem('search-options');
        if (!options) {
            useGlobalLink(path);
            return;
        }
        const searchOptions = JSON.parse(options);
        if (searchOptions.type === type && searchOptions.value === name) {
            // localStorage.removeItem('search-options');
            useGlobalLink("<%= url_for('archives') %>");
        } else {
            useGlobalLink(path);
        }
    }
    
    // 页面加载时高亮显示对应类型的标签卡片
    document.addEventListener('DOMContentLoaded', function() {
        const searchOptions = localStorage.getItem('search-options');
        if (searchOptions) {
            const { type, value } = JSON.parse(searchOptions);
            
            // 高亮对应的标签卡片
            const links = document.querySelectorAll(`span[onclick*="${type}"][onclick*="${value}"]`);
            links.forEach(link => {
                link.classList.add('highlight-tag');
            });
        }
    });
</script>

<style>
    /* 分类和标签容器样式 */
    .table-container table tbody tr td div.flex {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    
    /* 分类和标签链接样式 */
    .table-container table tbody tr td div.flex span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.25rem 0.5rem;
        background-color: rgba(59, 130, 246, 0.1);
        border-radius: 0.25rem;
        color: #94a3b8;
        text-decoration: none;
        font-size: 14px;
        height: 24px;
    }
    
    /* 分类和标签链接 hover 样式 */
    .table-container table tbody tr td div.flex span:hover {
        background-color: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }
    
    /* 高亮标签样式 */
    .highlight-tag {
        background-color: rgba(59, 130, 246, 0.3) !important;
        color: #3b82f6 !important;
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
    }
</style>