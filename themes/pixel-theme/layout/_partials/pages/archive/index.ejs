<section class="archive min-h-screen py-12">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold text-center mb-12 text-white">文章归档</h1>
        
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-primary text-primary-text">
                        <th class="py-4 px-4 text-left border border-secondary min-w-[150px] max-w-[300px]">标题</th>
                        <th class="py-4 px-4 text-left border border-secondary min-w-[150px] max-w-[300px]">分类</th>
                        <th class="py-4 px-4 text-left border border-secondary min-w-[150px] max-w-[300px]">标签</th>
                        <th class="py-4 px-4 text-left border border-secondary min-w-[150px] max-w-[300px]">创建时间</th>
                        <th class="py-4 px-4 text-left border border-secondary min-w-[150px] max-w-[300px]">修改时间</th>
                        <th class="py-4 px-4 text-left border border-secondary min-w-[150px] max-w-[300px]">操作</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (site.posts && site.posts.length > 0) { %>
                        <% site.posts.each(function(post, index) { %>
                            <tr class="<%= index % 2 === 0 ? 'bg-primary' : 'bg-secondary' %> text-primary-text hover:bg-tertiary transition-colors">
                                <td class="py-4 px-4 border border-secondary min-w-[150px] max-w-[300px]">
                                    <a href="<%= url_for(post.path) %>" class="hover:underline"><%= post.title %></a>
                                </td>
                                <td class="py-4 px-4 border border-secondary min-w-[150px] max-w-[300px]">
                                    <div class="flex flex-wrap gap-2">
                                        <% if (post.categories && post.categories.length > 0) { %>
                                            <% post.categories.each(function(category) { %>
                                                <span class="bg-tertiary text-primary-text px-2 py-1 rounded text-sm">
                                                    <%= category.name %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="text-secondary-text">无</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="py-4 px-4 border border-secondary min-w-[150px] max-w-[300px]">
                                    <div class="flex flex-wrap gap-2">
                                        <% if (post.tags && post.tags.length > 0) { %>
                                            <% post.tags.each(function(tag) { %>
                                                <span class="bg-tertiary text-primary-text px-2 py-1 rounded text-sm">
                                                    <%= tag.name %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="text-secondary-text">无</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="py-4 px-4 border border-secondary min-w-[150px] max-w-[300px]">
                                    <%= date(post.date, 'YYYY-MM-DD') %>
                                </td>
                                <td class="py-4 px-4 border border-secondary min-w-[150px] max-w-[300px]">
                                    <%= date(post.updated, 'YYYY-MM-DD') %>
                                </td>
                                <td class="py-4 px-4 border border-secondary min-w-[150px] max-w-[300px]">
                                    <a href="<%= url_for(post.path) %>" class="text-pixel-pink hover:underline mr-4">查看</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr class="bg-primary text-primary-text">
                            <td colspan="6" class="py-8 px-4 text-center border border-secondary">
                                暂无文章
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        
        <!-- 分页组件 -->
        <%- partial('_partials/component/pagination') %>
    </div>
</section>

<style>
    /* 为表格单元格添加滚动条 */
    table td {
        overflow-y: auto;
        max-height: 150px;
    }
    
    /* 为分类和标签卡片添加样式 */
    table td .flex {
        flex-wrap: wrap;
    }
    
    /* 为表格添加响应式样式 */
    @media (max-width: 768px) {
        table {
            font-size: 14px;
        }
        
        table th,
        table td {
            padding: 8px;
        }
    }
    
    /* 主题颜色变量 */
    .bg-primary {
        background-color: var(--color-bg-primary);
    }
    
    .bg-secondary {
        background-color: var(--color-bg-secondary);
    }
    
    .bg-tertiary {
        background-color: var(--color-bg-tertiary);
    }
    
    .text-primary-text {
        color: var(--color-text-primary);
    }
    
    .text-secondary-text {
        color: var(--color-text-secondary);
    }
    
    .border-secondary {
        border-color: var(--color-bg-secondary);
    }
</style>