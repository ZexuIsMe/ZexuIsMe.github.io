<section class="archive min-h-screen py-12">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold text-center mb-12 text-white">文章归档</h1>
        
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>标题</th>
                        <th>分类</th>
                        <th>标签</th>
                        <th>创建时间</th>
                        <th>修改时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (page.posts && page.posts.length > 0) { %>
                        <% page.posts.each(function(post, index) { %>
                            <tr>
                                <td><a href="<%= url_for(post.path) %>"><%= post.title %></a></td>
                                <td>
                                    <div class="flex">
                                        <% if (post.categories && post.categories.length > 0) { %>
                                            <% post.categories.each(function(category) { %>
                                                <span>
                                                    <%= category.name %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span>无</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <div class="flex">
                                        <% if (post.tags && post.tags.length > 0) { %>
                                            <% post.tags.each(function(tag) { %>
                                                <span>
                                                    <%= tag.name %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span>无</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td><%= date(post.date, 'YYYY-MM-DD') %></td>
                                <td><%= date(post.updated, 'YYYY-MM-DD') %></td>
                                <td><a href="<%= url_for(post.path) %>">查看</a></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr class="empty-row">
                            <td colspan="6">
                                暂无文章
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        
        <!-- 分页组件 -->
        <%- partial('../../component/pagination') %>
    </div>
</section>