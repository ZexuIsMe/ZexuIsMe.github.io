<%
    const {
        table_headers: headers, 
        no_posts_found: noPostsFound, 
        check: checkText,
        title: titleText,
    } = theme.archives;

    const { posts: postItems } = page;
%>
<section class="archive min-h-screen py-12">
    <div class="container mx-auto px-4">

        <h1 class="text-4xl font-bold text-center mb-12 text-white"><%= titleText %></h1>

        <!-- 搜索框 -->
        <%- partial('search') %>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <% headers.forEach(item => { %>
                            <th><%= item %></th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <% if (postItems && postItems.length > 0) { %>
                        <% postItems.each(function(post, index) { %>
                            <tr>
                                <td><a href="<%= url_for(post.path) %>"><%= post.title %></a></td>
                                <td>
                                    <div class="flex">
                                        <% if (post.categories && post.categories.length > 0) { %>
                                            <% post.categories.each(function(category) { %>
                                                <a href="<%= url_for(category.path) %>" onclick="handleCategoryClick('category', '<%= category.name %>', '<%= url_for(category.path) %>')"><%= category.name %></a>
                                            <% }); %>
                                        <% } else { %>
                                            <span>--</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <div class="flex">
                                        <% if (post.tags && post.tags.length > 0) { %>
                                            <% post.tags.each(function(tag) { %>
                                                <a href="<%= url_for(tag.path) %>" onclick="handleCategoryClick('tag', '<%= tag.name %>', '<%= url_for(tag.path) %>')"><%= tag.name %></a>
                                            <% }); %>
                                        <% } else { %>
                                            <span>--</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td><%= date(post.date, 'YYYY-MM-DD') %></td>
                                <td><%= date(post.updated, 'YYYY-MM-DD') %></td>
                                <td><a href="<%= url_for(post.path) %>"><%= checkText %></a></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr class="empty-row">
                            <!-- 暂无文章提示 -->
                            <td colspan="6"><%= noPostsFound %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        
        <!-- 分页组件 -->
        <%- partial('../../component/pagination') %>
    </div>
</section>

<style>
    .highlight-column {
        background-color: rgba(59, 130, 246, 0.15) !important;
        font-weight: 500;
    }
    
    .table-container table thead tr th.highlight-column {
        background-color: rgba(59, 130, 246, 0.3) !important;
    }
</style>

<script>
    // 处理分类点击事件
    const handleCategoryClick = (type, name, path) => {
        localStorage.setItem('search-options', JSON.stringify({
            type: type,
            value: name,
            path: path
        }));
    }
    
    // 监听搜索事件
    document.addEventListener('search', function(event) {
        const { type, value } = event.detail;
        console.log('接收到搜索参数:', { type, value });
    });
</script>