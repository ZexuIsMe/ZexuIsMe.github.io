<style type="text/tailwindcss">
    @layer bhcyl-utilities {
        .text-shadow {
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }
        .text-shadow-lg {
            text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.5);
        }
        .ancient-border {
            border-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect width="100" height="100" fill="none" stroke="%23D4AF37" stroke-width="4" rx="5" ry="5"/></svg>') 10;
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .character-card {
            transition: all 0.3s ease;
        }
        .character-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .floating {
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .cloud {
            position: absolute;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 50%;
            filter: blur(15px);
            animation: cloudMove 60s linear infinite;
        }
        @keyframes cloudMove {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(2000px); }
        }
    }
</style>

<div class="bg-gray-900 font-serif text-light overflow-x-hidden min-h-screen">
    <!-- 引入各个section -->
    <%- partial('sections/navbar') %>
    <!-- banner -->
    <%- partial('sections/home') %>
    <!-- 角色介绍 -->
    <%- partial('sections/characters') %>
    <!-- 功能介绍 -->
    <%- partial('sections/features') %>
    <!-- 截图展示 -->
    <%- partial('sections/screenshots') %>
    <!-- 下载链接 -->
    <%- partial('sections/download') %>
    <!-- 新闻动态 -->
    <%- partial('sections/news') %>
    <!-- 页脚 -->
    <%- partial('sections/footer') %>

    <script>
        // 初始化AOS动画库
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 800,
                easing: 'ease-in-out',
                once: true
            });
            
            // 移动端菜单切换
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            
            mobileMenuButton.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
            });
            
            // 平滑滚动
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    const targetElement = document.querySelector(targetId);
                    
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 80,
                            behavior: 'smooth'
                        });
                        
                        // 如果是移动端，点击后关闭菜单
                        if (window.innerWidth < 768) {
                            mobileMenu.classList.add('hidden');
                        }
                    }
                });
            });
            
            // 角色卡片点击效果
            const characterCards = document.querySelectorAll('.character-card');
            characterCards.forEach(card => {
                card.addEventListener('click', function() {
                    // 这里可以添加角色详情弹窗或跳转逻辑
                    console.log('Character card clicked');
                });
            });
            
            // 下载按钮点击效果
            const downloadButtons = document.querySelectorAll('#download button');
            downloadButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // 这里可以添加下载逻辑或跳转应用商店
                    alert('开始下载游戏客户端');
                });
            });
        });
    </script>
</div>