<%
    const characterItems = page.characterItems
%>

<!-- 角色展示区域 -->
<section id="characters" class="relative h-screen">
    <div class="min-h-screen container mx-auto relative">
        <!-- 底层：角色立绘（水平垂直居中） -->
        <div class="absolute inset-0 grid place-items-center z-10">
            <img 
                src="<%= url_for(characterItems[0].image) %>"
                alt="<%= characterItems[0].name %>"
                class="max-h-[60vh] md:max-h-[80vh] max-w-[90vw] md:max-w-[80vw] object-contain" 
                id="character-image"
                style="scale: 1.1;"
            >
        </div>
        
        <!-- 中间层：人物名字相关信息 -->
        <div class="absolute inset-0 z-20">
            <!-- 人物名字（垂直显示） -->
            <div 
                class="absolute flex items-start font-pixel"

                style="top: 7%; left: 7%;"
            >
                <div 
                    class="writing-vertical text-4xl md:text-6xl text-primary"
                    id="character-name"
                    style="font-size: 72px;"
                ><%= characterItems[0].name %></div>
                
                <div 
                    class="writing-vertical text-sm md:text-lg ml-4 md:ml-4 mt-4 md:mt-8 text-note"
                    id="character-info"
                    style="font-size: 24px;"
                ><%= characterItems[0].element %></div>
                <div 
                    class="writing-vertical text-sm md:text-lg ml-4 md:ml-4 mt-4 md:mt-8 text-note"
                    id="character-weapon"
                    style="font-size: 24px;"
                ><%= characterItems[0].weapon %></div>
                <div 
                    class="writing-vertical text-sm md:text-lg ml-4 md:ml-4 mt-4 md:mt-8 text-note"
                    id="character-position"
                    style="font-size: 24px;"
                ><%= characterItems[0].position %></div>
            </div>
        </div>
        
        <!-- 顶层：导航菜单 -->
        <div class="absolute inset-0 z-30">
            <!-- 移动端菜单 -->
            <div class="md:hidden container mx-auto px-4 h-full flex flex-col items-center justify-end pb-20">
                <div class="flex items-center justify-center w-full mb-4">
                    <div style="cursor: pointer;" class="hover:text-note mx-4" id="prev-character-mobile">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </div>
                    <div style="cursor: pointer;" class="hover:text-note mx-4" id="next-character-mobile">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                </div>
                <div class="w-full flex flex-row overflow-x-auto pb-2 font-pixel" id="character-menu-mobile">
                    <% characterItems.forEach((character, index) => { %>
                        <div style="cursor: pointer;" class="hover:text-note whitespace-nowrap px-4 py-2 <%= index === 0 ? 'font-bold text-primary' : '' %>" data-index="<%= index %>"><%= character.name %></div>
                    <% }) %>
                </div>
            </div>
            
            <!-- 桌面端菜单 -->
            <div class="hidden md:block container mx-auto px-4 h-full flex items-center justify-end">
                <div class="w-full h-full flex flex-col justify-center items-end">
                    <div class="w-32 text-center">
                        <div class="">
                            <div class="text-sm opacity-70">修士</div>
                        </div>
                        <div style="cursor: pointer;" class="hover:text-note my-8" id="prev-character">
                            <i class="fas fa-angle-up"></i>
                        </div>
                        <div class="space-y-4" id="character-menu">
                            <% characterItems.forEach((character, index) => { %>
                                <div
                                    style="cursor: pointer;"
                                    class="hover:text-primary <%= index === 0 ? 'font-bold text-primary' : '' %>"
                                    data-index="<%= index %>"
                                ><%= character.name %></div>
                            <% }) %>
                        </div>
                        <div style="cursor: pointer;" class="hover:text-note my-8" id="next-character">
                            <i class="fas fa-angle-down"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const characterItems = JSON.parse('<%- JSON.stringify(characterItems) %>');
        let currentIndex = 0;
        const menuItems = document.querySelectorAll('#character-menu div');
        const mobileMenuItems = document.querySelectorAll('#character-menu-mobile div');
        const characterName = document.getElementById('character-name');
        const characterInfo = document.getElementById('character-info');
        const characterWeapon = document.getElementById('character-weapon');
        const characterPosition = document.getElementById('character-position');
        const characterImage = document.getElementById('character-image');
        
        // 共享的角色切换函数
        function switchCharacter(index) {
            currentIndex = index;
            const character = characterItems[index];
            
            // 更新桌面端菜单选中状态
            if (menuItems.length > 0) {
                menuItems.forEach(menuItem => {
                    menuItem.classList.remove('font-bold', 'text-primary');
                });
                if (menuItems[index]) {
                    menuItems[index].classList.add('font-bold', 'text-primary');
                }
            }
            
            // 更新移动端菜单选中状态
            if (mobileMenuItems.length > 0) {
                mobileMenuItems.forEach(menuItem => {
                    menuItem.classList.remove('font-bold', 'text-primary');
                });
                if (mobileMenuItems[index]) {
                    mobileMenuItems[index].classList.add('font-bold', 'text-primary');
                }
            }
            
            // 添加淡出效果
            characterName.classList.add('fade-out');
            characterInfo.classList.add('fade-out');
            characterWeapon.classList.add('fade-out');
            characterPosition.classList.add('fade-out');
            characterImage.classList.add('image-fade-out');
            
            // 等待动画完成后更新内容
            setTimeout(() => {
                // 更新角色信息
                characterName.textContent = character.name;
                characterInfo.textContent = character.element;
                characterWeapon.textContent = character.weapon;
                characterPosition.textContent = character.position;
                
                // 更新角色图片
                characterImage.src = '<%= url_for("") %>' + character.image;
                characterImage.alt = character.name;
                
                // 重置过渡类
                characterName.classList.remove('fade-out');
                characterInfo.classList.remove('fade-out');
                characterWeapon.classList.remove('fade-out');
                characterPosition.classList.remove('fade-out');
                characterImage.classList.remove('image-fade-out');
                
                // 触发重排
                void characterName.offsetWidth;
                
                // 添加淡入效果
                characterName.classList.add('fade-in');
                characterInfo.classList.add('fade-in');
                characterWeapon.classList.add('fade-in');
                characterPosition.classList.add('fade-in');
                characterImage.classList.add('image-fade-in');
                
                // 动画完成后移除类
                setTimeout(() => {
                    characterName.classList.remove('fade-in');
                    characterInfo.classList.remove('fade-in');
                    characterWeapon.classList.remove('fade-in');
                    characterPosition.classList.remove('fade-in');
                    characterImage.classList.remove('image-fade-in');
                }, 600);
            }, 300);
        }
        
        // 桌面端菜单点击事件
        menuItems.forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const index = parseInt(this.getAttribute('data-index'));
                switchCharacter(index);
            });
        });
        
        // 移动端菜单点击事件
        mobileMenuItems.forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const index = parseInt(this.getAttribute('data-index'));
                switchCharacter(index);
            });
        });
        
        // 获取导航按钮元素
        const prevCharacterBtn = document.getElementById('prev-character');
        const nextCharacterBtn = document.getElementById('next-character');
        const prevCharacterMobileBtn = document.getElementById('prev-character-mobile');
        const nextCharacterMobileBtn = document.getElementById('next-character-mobile');
        
        // 上一个角色导航函数
        function goToPreviousCharacter() {
            let newIndex = currentIndex - 1;
            if (newIndex < 0) {
                newIndex = characterItems.length - 1;
            }
            switchCharacter(newIndex);
        }
        
        // 下一个角色导航函数
        function goToNextCharacter() {
            let newIndex = currentIndex + 1;
            if (newIndex >= characterItems.length) {
                newIndex = 0;
            }
            switchCharacter(newIndex);
        }
        
        // 桌面端导航按钮点击事件
        if (prevCharacterBtn) {
            prevCharacterBtn.addEventListener('click', function(e) {
                e.preventDefault();
                goToPreviousCharacter();
            });
        }
        
        if (nextCharacterBtn) {
            nextCharacterBtn.addEventListener('click', function(e) {
                e.preventDefault();
                goToNextCharacter();
            });
        }
        
        // 移动端导航按钮点击事件
        if (prevCharacterMobileBtn) {
            prevCharacterMobileBtn.addEventListener('click', function(e) {
                e.preventDefault();
                goToPreviousCharacter();
            });
        }
        
        if (nextCharacterMobileBtn) {
            nextCharacterMobileBtn.addEventListener('click', function(e) {
                e.preventDefault();
                goToNextCharacter();
            });
        }
    });
</script>

<style>
    #characters {
        position: relative;
    }
    
    #characters::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
    }
    
    @media (max-width: 768px) {
        #characters::before {
            background: linear-gradient(180deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.8) 100%);
        }
    }
    
    #characters .container {
        position: relative;
        z-index: 2;
    }
    
    .writing-vertical {
        writing-mode: vertical-rl;
        text-orientation: upright;
        letter-spacing: 0.5em;
    }
    
    @media (max-width: 768px) {
        .writing-vertical {
            letter-spacing: 0.3em;
        }
    }
    
    /* 过渡效果样式 */
    #character-name,
    #character-info,
    #character-weapon,
    #character-position {
        transition: all 0.5s ease-in-out;
    }
    
    #character-image {
        transition: all 0.6s ease-in-out;
    }
    
    /* 淡出效果类 */
    .fade-out {
        opacity: 0;
        transform: translateY(20px);
    }
    
    /* 淡入效果类 */
    .fade-in {
        opacity: 1;
        transform: translateY(0);
    }
    
    /* 图片淡入淡出效果 */
    .image-fade-out {
        opacity: 0;
    }
    
    .image-fade-in {
        opacity: 1;
    }
    
    /* 移动端菜单样式 */
    #character-menu-mobile {
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.5) transparent;
    }
    
    #character-menu-mobile::-webkit-scrollbar {
        height: 4px;
    }
    
    #character-menu-mobile::-webkit-scrollbar-track {
        background: transparent;
    }
    
    #character-menu-mobile::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.5);
        border-radius: 20px;
    }
    
    /* 移动端菜单项样式 */
    #character-menu-mobile div {
        transition: all 0.3s ease;
    }
    
    #character-menu-mobile div:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }
</style>