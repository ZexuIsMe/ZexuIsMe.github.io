<!-- 游戏截图区域 -->

<%
    const { screenshots, screenshots_title: title, screenshots_subtitle: subtitle } = page
    let screenshotsArray = [];
    if (screenshots && screenshots.length > 0) {
        screenshotsArray = screenshots.map(s => ({
            src: url_for(s.src),
            title: s.title || ''
        }));
    }
    const randomIndex = Math.floor(Math.random() * screenshotsArray.length);
%>

<section class="py-24 bg-light-bg relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: url('<%= screenshotsArray[randomIndex].src %>'); background-size: cover; background-position: center; background-attachment: fixed;"></div>
    <div class="mx-auto px-4 z-10 relative">
        <div class="text-center mb-16">
            <h2 class="text-5xl mb-4 animate-ink-fade" style="animation-delay: 0.1s">
                <%= title %>
            </h2>
            <div class="w-32 h-1 mx-auto mb-6 animate-ink-fade" style="animation-delay: 0.2s"></div>
            <p class="text-note text-lg animate-ink-fade" style="animation-delay: 0.3s">
                <%= subtitle %>
            </p>
        </div>
    </div>
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6" id="screenshotsGrid">
            <% screenshotsArray.forEach((item, index) => { %>
                <div 
                    id="screenshots-<%= index %>"
                    class="relative group overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 cursor-pointer screenshot-item" 
                    data-index="<%= index %>" 
                    onclick="openLightbox('<%= index %>')"
                    style="display: none;"
                >
                    <img src="<%= item.src %>" alt="<%= item.title || '场景' + (index + 1) %>" class="w-full h-64 object-cover">
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300"></div>
                </div>
            <% }) %>
        </div>
        
        <div class="text-center mt-12" id="loadMoreContainer">
            <button 
                class="hover:bg-secondary font-bold py-3 px-8 rounded-full transition-all duration-300"
                onclick="loadMoreScreenshots()"
                id="loadMoreBtn"
                style="cursor: pointer"
            >
                加载更多
            </button>
        </div>
    </div>

    <div class="py-20" data-desc="填充物"></div>

    <div id="lightbox" class="fixed inset-0 z-50 hidden bg-light-bg/90 flex items-center justify-center" onclick="closeLightboxOnOutsideClick(event)">
        <div
            onclick="closeLightbox(); event.stopPropagation()"
            class="absolute top-4 right-4 text-4xl hover:text-primary z-10"
        >
            <i class="fa-solid fa-xmark"></i>
        </div>
        <div
            onclick="prevLightboxImage(); event.stopPropagation()"
            class="absolute left-4 text-4xl hover:text-primary transition-colors z-10"
        >
            <i class="fa-solid fa-angle-left"></i>
        </div>
        <div
            onclick="nextLightboxImage(); event.stopPropagation()"
            class="absolute right-4 text-4xl hover:text-primary transition-colors z-10"
        >
            <i class="fa-solid fa-angle-right"></i>
        </div>
        <div class="px-4" onclick="event.stopPropagation()">
            <img id="lightboxImage" src="" alt="" class="max-w-full max-h-[85vh] object-contain">
        </div>

        <div class="absolute" style="left: 50%; bottom: 3%; transform: translateX(-50%);">
            <i class="fa-solid fa-download text-4xl hover:text-primary transition-colors z-10 cursor-pointer" onclick="downloadImage(); event.stopPropagation()"></i>
        </div>
    </div>
</section>

<script>
    const items = JSON.parse('<%- JSON.stringify(screenshotsArray) %>');
    let currentSlide = 0;
    const totalSlides = items.length;
    let currentLightboxIndex = 0;

    const updateGallery = () => {
        const prevIndex = (currentSlide - 1 + totalSlides) % totalSlides;
        const nextIndex = (currentSlide + 1) % totalSlides;
        
        const prevImage = document.getElementById('prevImage');
        const currentImage = document.getElementById('currentImage');
        const nextImage = document.getElementById('nextImage');
        
        prevImage.querySelector('img').src = items[prevIndex].src;
        prevImage.querySelector('.absolute.bottom-3.left-3').textContent = items[prevIndex].title || `场景${prevIndex + 1}`;
        
        currentImage.querySelector('img').src = items[currentSlide].src;
        currentImage.querySelector('.absolute.bottom-3.left-3').textContent = items[currentSlide].title || `场景${currentSlide + 1}`;
        
        nextImage.querySelector('img').src = items[nextIndex].src;
        nextImage.querySelector('.absolute.bottom-3.left-3').textContent = items[nextIndex].title || `场景${nextIndex + 1}`;
        
        document.querySelectorAll('.gallery-indicator').forEach((indicator, index) => {
            if (index === currentSlide) {
                indicator.classList.add('bg-ink-accent', 'w-6');
                indicator.classList.remove('bg-ink-accent/40');
            } else {
                indicator.classList.remove('bg-ink-accent', 'w-6');
                indicator.classList.add('bg-ink-accent/40');
            }
        });
    };

    const goToSlide = (index) => {
        currentSlide = index;
        updateGallery();
    };

    const nextSlide = () => {
        currentSlide = (currentSlide + 1) % totalSlides;
        updateGallery();
    };

    const prevSlide = () => {
        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
        updateGallery();
    };

    const openLightbox = (index) => {
        currentLightboxIndex = index;
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = document.getElementById('lightboxImage');
        
        lightboxImage.src = items[index].src;
        lightboxImage.alt = items[index].title || `场景${index + 1}`;
        
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
        const lightbox = document.getElementById('lightbox');
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
    };

    const nextLightboxImage = () => {
        currentLightboxIndex = (currentLightboxIndex + 1) % items.length;
        const lightboxImage = document.getElementById('lightboxImage');
        
        lightboxImage.src = items[currentLightboxIndex].src;
    };

    const prevLightboxImage = () => {
        currentLightboxIndex = (currentLightboxIndex - 1 + items.length) % items.length;
        const lightboxImage = document.getElementById('lightboxImage');
        
        lightboxImage.src = items[currentLightboxIndex].src;
    };

    const downloadImage = () => {
        const currentItem = items[currentLightboxIndex];
        const link = document.createElement('a');
        link.href = currentItem.src;
        link.download = '碧海苍云录' + new Date().toLocaleString() + '.png';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    const closeLightboxOnOutsideClick = (event) => {
        if (event.target === event.currentTarget) {
            closeLightbox();
        }
    };

    document.addEventListener('keydown', (e) => {
        const lightbox = document.getElementById('lightbox');
        if (lightbox.classList.contains('hidden')) return;
        
        if (e.key === 'Escape') {
            closeLightbox();
        } else if (e.key === 'ArrowRight') {
            nextLightboxImage();
        } else if (e.key === 'ArrowLeft') {
            prevLightboxImage();
        }
    });

    let visibleCount = 3;
    const itemsPerLoad = 3;

    const loadMoreScreenshots = () => {
        const items = document.querySelectorAll('.screenshot-item');
        const totalItems = items.length;
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        const loadMoreContainer = document.getElementById('loadMoreContainer');

        // 计算需要显示的下一批项目的结束索引
        const endIndex = Math.min(visibleCount + itemsPerLoad, totalItems);

        // 显示从当前可见数到结束索引的项目
        for (let i = visibleCount; i < endIndex; i++) {
            if (items[i]) {
                items[i].style.display = '';
            }
        }

        // 更新当前可见项目数
        visibleCount = endIndex;

        // 如果所有项目都已显示，隐藏加载更多按钮
        if (visibleCount >= totalItems) {
            loadMoreContainer.style.display = 'none';
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        // 检查是否需要显示加载更多按钮
        const items = document.querySelectorAll('.screenshot-item');
        const loadMoreContainer = document.getElementById('loadMoreContainer');
        items.forEach((item, index) => {
            if (index < 3) {
                item.style.display = 'block';
            }
        });
        
        if (items.length <= 3) {
            loadMoreContainer.style.display = 'none';
        }
    });
</script>