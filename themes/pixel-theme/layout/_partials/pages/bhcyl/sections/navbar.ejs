<!-- 导航栏 -->
<nav class="fixed top-0 left-0 w-full z-50 bg-light-bg/80 backdrop-blur-sm border-b border-border">
    <div class="container mx-auto px-4 py-3 flex justify-between items-center font-pixel">
        <div class="flex items-center" onclick="window.location.href = '/index'" style="cursor: pointer;">
            <img src="<%= theme['logo'] %>" alt="Logo" class="h-12 w-12 rounded-full border-2 border-primary">
            <h1 class="ml-3 text-2xl font-pixel text-primary"><%= config.title %></h1>
        </div>
        <div class="hidden md:flex space-x-8">
            <% page.nav.forEach((item) => { %>
                <a 
                    href="<%= item.path %>" 
                    class="text-text hover:text-primary transition-colors duration-300"
                ><%= item.text %></a>
            <% }) %>
        </div>
        <div class="md:hidden">
            <button id="mobile-menu-button" class="text-text focus:outline-none">
                <i class="fa fa-bars text-2xl"></i>
            </button>
        </div>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-light-bg/90 w-full border-t border-border">
        <div class="container mx-auto px-4 py-3 flex flex-col space-y-4">
            <% page.nav.forEach((item) => { %>
                <a 
                    href="<%= item.path %>" 
                    class="text-text hover:text-primary transition-colors duration-300 py-2"
                ><%= item.text %></a>
            <% }) %>
        </div>
    </div>
</nav>