<%
    const characterItems = [
        {
            name: '小师弟',
            image: 'images/bhcyl/characters/小师弟.png',
            element: '五行齐灵根',
            weapon: '剑修',
            position: '齐灵宗',
        }, {
            name: '大师姐',
            image: 'images/bhcyl/characters/大师姐.png',
            element: '五行灵根',
            weapon: '枪修',
            position: '齐灵宗',
        }, {
            name: '师傅',
            image: 'images/bhcyl/characters/师傅.png',
            element: '五行齐灵根',
            weapon: '气修',
            position: '齐灵宗',
        }, {
            name: '龙枪',
            image: 'images/bhcyl/characters/龙枪.png',
            element: '土灵根',
            weapon: '枪修',
            position: '磐龙门',
        }, {
            name: '洛师姐',
            image: 'images/bhcyl/characters/洛师姐.png',      
            element: '水灵根',
            weapon: '剑修',
            position: '汐云宫',
        }, {
            name: '水剑',
            image: 'images/bhcyl/characters/水剑.png',
            element: '水灵根',
            weapon: '剑修',
            position: '汐云宫',
        }
    ]
%>

<!-- 角色展示区域 -->
<section id="characters" class="bg-dark-bg-primary relative overflow-hidden">
    <div class="py-10"></div>

    <div class="absolute inset-0 " style="opacity: 0.2;">
        <div class="absolute inset-0 bg-[url('<%= url_for('/images/bhcyl/bg.png') %>')]"></div>
    </div>

    <div class="min-h-screen container mx-auto relative">
        <!-- 底层：角色立绘（水平垂直居中） -->
        <div class="absolute inset-0 flex justify-center items-center z-10">
            <img 
                src="<%= url_for(characterItems[0].image) %>" 
                alt="<%= characterItems[0].name %>" 
                class="max-h-[80vh] max-w-[80vw] object-contain" 
                id="character-image"
                style="scale: 1.25"
            >
        </div>
        
        <!-- 中间层：人物名字相关信息 -->
        <div class="absolute inset-0 z-20">
            <!-- 人物名字（垂直显示） -->
            <div class="absolute flex items-start" style="left: 22%;">
                <div class="writing-vertical text-6xl font-bold text-white" id="character-name"><%= characterItems[0].name %></div>
                
                <!-- 元素和武器信息 -->
                <div class="writing-vertical text-white text-lg ml-4 mt-8" id="character-info"><%= characterItems[0].element %></div>
                <div class="writing-vertical text-white text-lg ml-4 mt-8" id="character-weapon"><%= characterItems[0].weapon %></div>
                <div class="writing-vertical text-white text-lg ml-4 mt-8" id="character-position"><%= characterItems[0].position %></div>
            </div>
        </div>
        
        <!-- 顶层：导航菜单 -->
        <div class="absolute inset-0 z-30">
            <div class="container mx-auto px-4 h-full flex items-center justify-end">
                <div class="w-64 flex flex-col">
                    <div class="text-white mb-8">
                        <div class="text-sm opacity-70">修士</div>
                    </div>
                    <div class="space-y-4" id="character-menu">
                        <% characterItems.forEach((character, index) => { %>
                            <div style="cursor: pointer;" class="text-white hover:text-gray-300 <%= index === 0 ? 'font-bold border-l-4 border-white pl-3' : '' %>" data-index="<%= index %>"><%= character.name %></div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const characterItems = JSON.parse('<%- JSON.stringify(characterItems) %>');
        const menuItems = document.querySelectorAll('#character-menu div');
        const characterName = document.getElementById('character-name');
        const characterInfo = document.getElementById('character-info');
        const characterWeapon = document.getElementById('character-weapon');
        const characterPosition = document.getElementById('character-position');
        const characterImage = document.getElementById('character-image');
        
        menuItems.forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const index = parseInt(this.getAttribute('data-index'));
                const character = characterItems[index];
                
                // 更新菜单选中状态
                menuItems.forEach(menuItem => {
                    menuItem.classList.remove('font-bold', 'border-l-4', 'border-white', 'pl-3');
                });
                this.classList.add('font-bold', 'border-l-4', 'border-white', 'pl-3');
                
                // 更新角色信息
                characterName.textContent = character.name;
                characterInfo.textContent = character.element;
                characterWeapon.textContent = character.weapon;
                characterPosition.textContent = character.position;
                
                // 更新角色图片
                characterImage.src = '<%= url_for("") %>' + character.image;
                characterImage.alt = character.name;
            });
        });
    });
</script>

<style>
    #characters {
        position: relative;
    }
    
    #characters::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
        z-index: 1;
    }
    
    #characters .container {
        position: relative;
        z-index: 2;
    }
    
    .writing-vertical {
        writing-mode: vertical-rl;
        text-orientation: upright;
        letter-spacing: 0.5em;
    }
</style>