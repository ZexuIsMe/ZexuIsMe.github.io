<%
    const characterItems = page.characterItems
%>

<!-- 角色展示区域 -->
<section id="characters" class="bg-dark-bg-primary relative overflow-hidden">
    <div class="py-10"></div>

    <div class="absolute inset-0 " style="opacity: 0.2;">
        <div class="absolute inset-0 bg-[url('<%= url_for('/images/bhcyl/bg.png') %>')]"></div>
    </div>

    <div class="min-h-screen container mx-auto relative">
        <!-- 底层：角色立绘（水平垂直居中） -->
        <div class="absolute inset-0 flex justify-center items-center z-10" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
            <img 
                src="<%= url_for(characterItems[0].image) %>"
                alt="<%= characterItems[0].name %>"
                class="max-h-[80vh] max-w-[80vw] object-contain" 
                id="character-image"
                style="scale: 1.25"
            >
        </div>
        
        <!-- 中间层：人物名字相关信息 -->
        <div class="absolute inset-0 z-20">
            <!-- 人物名字（垂直显示） -->
            <div class="absolute flex items-start" style="left: 22%;" data-aos="fade-right" data-aos-duration="800" data-aos-delay="400">
                <div class="writing-vertical text-6xl font-bold text-white" id="character-name"><%= characterItems[0].name %></div>
                
                <!-- 元素和武器信息 -->
                <div class="writing-vertical text-white text-lg ml-4 mt-8" id="character-info"><%= characterItems[0].element %></div>
                <div class="writing-vertical text-white text-lg ml-4 mt-8" id="character-weapon"><%= characterItems[0].weapon %></div>
                <div class="writing-vertical text-white text-lg ml-4 mt-8" id="character-position"><%= characterItems[0].position %></div>
            </div>
        </div>
        
        <!-- 顶层：导航菜单 -->
        <div class="absolute inset-0 z-30">
            <div class="container mx-auto px-4 h-full flex items-center justify-end" data-aos="fade-left" data-aos-duration="800" data-aos-delay="600">
                <div class="w-64 flex flex-col">
                    <div class="text-white mb-8">
                        <div class="text-sm opacity-70">修士</div>
                    </div>
                    <div class="space-y-4" id="character-menu">
                        <% characterItems.forEach((character, index) => { %>
                            <div style="cursor: pointer;" class="text-white hover:text-gray-300 <%= index === 0 ? 'font-bold border-l-4 border-white pl-3' : '' %>" data-index="<%= index %>" data-aos="fade-left" data-aos-duration="600" data-aos-delay="<%= 700 + index * 100 %>"><%= character.name %></div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const characterItems = JSON.parse('<%- JSON.stringify(characterItems) %>');
        const menuItems = document.querySelectorAll('#character-menu div');
        const characterName = document.getElementById('character-name');
        const characterInfo = document.getElementById('character-info');
        const characterWeapon = document.getElementById('character-weapon');
        const characterPosition = document.getElementById('character-position');
        const characterImage = document.getElementById('character-image');
        
        menuItems.forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const index = parseInt(this.getAttribute('data-index'));
                const character = characterItems[index];
                
                // 更新菜单选中状态
                menuItems.forEach(menuItem => {
                    menuItem.classList.remove('font-bold', 'border-l-4', 'border-white', 'pl-3');
                });
                this.classList.add('font-bold', 'border-l-4', 'border-white', 'pl-3');
                
                // 添加淡出效果
                characterName.classList.add('fade-out');
                characterInfo.classList.add('fade-out');
                characterWeapon.classList.add('fade-out');
                characterPosition.classList.add('fade-out');
                characterImage.classList.add('image-fade-out');
                
                // 等待动画完成后更新内容
                setTimeout(() => {
                    // 更新角色信息
                    characterName.textContent = character.name;
                    characterInfo.textContent = character.element;
                    characterWeapon.textContent = character.weapon;
                    characterPosition.textContent = character.position;
                    
                    // 更新角色图片
                    characterImage.src = '<%= url_for("") %>' + character.image;
                    characterImage.alt = character.name;
                    
                    // 重置过渡类
                    characterName.classList.remove('fade-out');
                    characterInfo.classList.remove('fade-out');
                    characterWeapon.classList.remove('fade-out');
                    characterPosition.classList.remove('fade-out');
                    characterImage.classList.remove('image-fade-out');
                    
                    // 触发重排
                    void characterName.offsetWidth;
                    
                    // 添加淡入效果
                    characterName.classList.add('fade-in');
                    characterInfo.classList.add('fade-in');
                    characterWeapon.classList.add('fade-in');
                    characterPosition.classList.add('fade-in');
                    characterImage.classList.add('image-fade-in');
                    
                    // 动画完成后移除类
                    setTimeout(() => {
                        characterName.classList.remove('fade-in');
                        characterInfo.classList.remove('fade-in');
                        characterWeapon.classList.remove('fade-in');
                        characterPosition.classList.remove('fade-in');
                        characterImage.classList.remove('image-fade-in');
                    }, 600);
                }, 300);
            });
        });
    });
</script>

<style>
    #characters {
        position: relative;
    }
    
    #characters::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
        z-index: 1;
    }
    
    #characters .container {
        position: relative;
        z-index: 2;
    }
    
    .writing-vertical {
        writing-mode: vertical-rl;
        text-orientation: upright;
        letter-spacing: 0.5em;
    }
    
    /* 过渡效果样式 */
    #character-name,
    #character-info,
    #character-weapon,
    #character-position {
        transition: all 0.5s ease-in-out;
    }
    
    #character-image {
        transition: all 0.6s ease-in-out;
    }
    
    /* 淡出效果类 */
    .fade-out {
        opacity: 0;
        transform: translateY(20px);
    }
    
    /* 淡入效果类 */
    .fade-in {
        opacity: 1;
        transform: translateY(0);
    }
    
    /* 图片淡入淡出效果 */
    .image-fade-out {
        opacity: 0;
    }
    
    .image-fade-in {
        opacity: 1;
    }
</style>