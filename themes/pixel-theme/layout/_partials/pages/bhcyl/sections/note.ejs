<!-- 笔记区域 -->
<% 
    const { sort, title, imgDefault: imageDefault, excerpt } = page.note;
    
    const bhcylPosts = site.posts.filter(post => {
                            const categories = post.categories.toArray();
                            return categories.some(cat => cat.name === page.title);
                        }).sort(sort);
%>

<section id="bhcyl-note" class="py-20 bg-gray-900 relative">
    <div class="container mx-auto px-4 z-10 relative">
        <h2 class="text-4xl text-center text-ancient-gold mb-16" data-aos="fade-up">
            <%= title %>
        </h2>
        
        <div class="grid gap-8">
            <% bhcylPosts.forEach(post => { %>
                <div 
                    onclick="window.location.href=`<%= url_for(post.path) %>`"
                    class="bg-gray-800/80 rounded-lg overflow-hidden border border-ancient-gold/30 backdrop-blur-sm hover:border-ancient-gold hover:shadow-lg hover:shadow-ancient-gold/30 hover:scale-105 transition-all duration-300 cursor-pointer flex flex-col md:flex-row"
                >
                    <div class="md:w-2/5 h-48 md:h-auto bg-gray-700 relative overflow-hidden bg-[url(<%= post.cover ? url_for(post.cover) : url_for(imageDefault) %>)] bg-cover opacity-70 min-h-[200px]">
                        <div class="absolute bottom-4 left-4">
                            <span class="bg-ancient-gold text-black text-xs px-2 py-1 rounded">
                                <%= date(post.date, 'YYYY-MM-DD') %>
                            </span>
                        </div>
                    </div>
                    <div class="md:w-3/5 p-6 markdown-body flex flex-col justify-center">
                        <h3 class="text-xl text-ancient-gold mb-3"><%= post.title %></h3>
                        <div class="excerpt mb-4" style="color: white;">
                            <% if (post.excerpt) { %>
                                <%- post.excerpt %>
                            <% } else { %>
                                <%- markdown(excerpt) %>
                            <% } %>
                        </div>
                        <a href="<%= url_for(post.path) %>">
                        </a>
                        <span
                            class="text-ancient-gold hover:text-yellow-400 transition-colors duration-300 flex items-center"
                        >
                            阅读更多
                            <i class="fa fa-arrow-right ml-2"></i>
                        </span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>