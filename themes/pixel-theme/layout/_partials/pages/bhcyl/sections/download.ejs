<!-- 下载区域 -->
<section id="download" class="py-20 bg-gradient-to-b from-black to-gray-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(212,175,55,0.3),transparent_70%)]"></div>
    </div>
    
    <div class="container mx-auto px-4 z-10 relative">
        <div class="max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-2xl" data-aos="fade-up">
            <!-- 底层图片 -->
            <div class="relative">
                <img src="/images/bhcyl/bg-card.png" alt="碧海苍云录" class="w-full h-auto object-cover rounded-2xl">
                
                <!-- 上层文字和内容 -->
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/50 to-transparent rounded-2xl flex flex-col justify-center">
                    <div class="">
                        <div class="flex flex-col md:flex-row justify-center gap-4 md:gap-6">
                            <button 
                                style="width: 200px;"
                                class="flex items-center justify-center gap-3 bg-black hover:bg-gray-800 text-white py-3 md:py-4 px-6 md:px-8 rounded-lg transition-all duration-300 transform hover:scale-105 md:w-auto"
                            >
                                <i class="fa-brands fa-android"></i>
                                <div class="text-left">
                                    <div class="text-base md:text-lg" onclick="window.location.href=`<%= page.website %>`">TapTap</div>
                                </div>
                            </button>
                        </div>
                        
                        <div class="mt-6 md:mt-10 text-center">
                            <p class="text-gray-400 text-xs md:text-sm">
                                版本：0.24.1 | 大小：555MB | 适龄提示：16+
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>