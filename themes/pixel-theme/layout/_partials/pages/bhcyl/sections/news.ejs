<!-- 新闻资讯区域 -->
<% 
    const { sort } = page.news;
    
    const bhcylPosts = site.posts.filter(post => {
                            const categories = post.categories.toArray();
                            return categories.some(cat => cat.name === page.title);
                        }).sort(sort);
%>

<section id="news" class="py-20 bg-gray-900 relative">
    <div class="container mx-auto px-4 z-10 relative">
        <h2 class="text-4xl text-center text-ancient-gold mb-16" data-aos="fade-up">
            <%= page.news.title %>
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            <% bhcylPosts.forEach((post, index) => { %>
                <div 
                    onclick="window.location.href=`<%= url_for(post.path) %>`"
                    class="bg-gray-800/80 rounded-lg overflow-hidden border border-ancient-gold/30 backdrop-blur-sm hover:border-ancient-gold hover:shadow-lg hover:shadow-ancient-gold/30 hover:scale-105 transition-all duration-300 cursor-pointer"
                >
                    <div class="h-48 bg-gray-700 relative overflow-hidden bg-[url(<%= post.cover ? url_for(post.cover) : url_for(page.news.imgDefault) %>)] bg-cover opacity-70">
                        <div class="absolute bottom-4 left-4">
                            <span class="bg-ancient-gold text-black text-xs px-2 py-1 rounded">
                                <%= date(post.date, 'YYYY-MM-DD') %>
                            </span>
                        </div>
                    </div>
                    <div class="p-6 markdown-body">
                        <h3 class="text-xl text-ancient-gold mb-3"><%= post.title %></h3>
                        <div class="excerpt" style="color: white;">
                            <% if (post.excerpt) { %>
                                <%- post.excerpt %>
                            <% } else { %>
                                <%- markdown(page.news.excerpt) %>
                            <% } %>
                        </div>
                        <a href="<%= url_for(post.path) %>">
                        </a>
                        <span
                            class="text-ancient-gold hover:text-yellow-400 transition-colors duration-300 flex items-center"
                        >
                            阅读更多
                            <i class="fa fa-arrow-right ml-2"></i>
                        </span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>