<!-- 首页banner -->
<section id="home" class="min-h-screen pt-16">
    <div class="container mx-auto px-4">
        <div class="relative mb-12">
            <img src="https://p3-flow-imagex-sign.byteimg.com/tos-cn-i-a9rns2rl98/rc/pc/super_tool/33bd01abf9ca4a529341d122bdfa4104~tplv-a9rns2rl98-image.image?lk3s=8e244e95&rcl=20260202192528FF625BE2146F4D36E478&rrcfp=f06b921b&x-expires=1772623632&x-signature=7NWhx5n0EdrTyCjnqkWvN0dMAdo%3D" alt="Banner" class="w-full h-auto pixel-art pixel-border">
        </div>

        <h2 class="text-3xl font-bold mb-8 text-pixel-pink text-shadow">最新文章</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% site.posts.sort('date', -1).slice(0, 3).forEach(post => { %>
                <div class="pixel-card p-6">
                    <h3 class="text-xl font-bold mb-4 text-pixel-blue"><%= post.title %></h3>
                    <p class="excerpt markdown-body">
                        <!-- 如果摘要长度超过配置项长度，截取并添加省略号 -->
                        <% if (post.excerpt) { %>
                            <%- post.excerpt.length > theme.auto_excerpt.length 
                                ? post.excerpt.substring(0, theme.auto_excerpt.length) + '<span class="excerpt-ellipsis">...</span>' 
                                : post.excerpt %>
                        <% } else { %>
                            没有摘要，要不点进来看看吧 :）
                        <% } %>
                    </p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-note"><%= post.date.format('YYYY-MM-DD') %></span>
                        <a href="<%- url_for(post.path) %>" class="pixel-button">点击阅读更多了解详情...</a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
<!-- 文章列表 -->
<section id="articles" class="min-h-screen pt-16">
    <div class="container mx-auto px-4 py-12">
        <h2 class="text-3xl font-bold mb-8 text-pixel-pink text-shadow">文章列表</h2>
        
        <div class="flex flex-wrap gap-4 mb-8">
            <button class="article-filter active pixel-button" data-filter="all">全部</button>
            <button class="article-filter pixel-button" data-filter="tutorial">教程</button>
            <button class="article-filter pixel-button" data-filter="news">资讯</button>
            <button class="article-filter pixel-button" data-filter="review">评测</button>
        </div>
        
        <div class="mb-8">
            <input type="text" id="article-search" placeholder="搜索文章..." class="w-full md:w-1/2 px-4 py-2 bg-dark border-2 border-pixel-blue text-white">
        </div>
        
        <div id="articles-container" class="space-y-8">
            <% site.posts.forEach(post => { %>
                <div class="article-item pixel-card p-6" data-category="<%= post.categories[0] %>">
                    <h3 class="text-2xl font-bold mb-4 text-pixel-blue"><%= post.title %></h3>
                    <p class="excerpt markdown-body">
                        <!-- 如果摘要长度超过配置项长度，截取并添加省略号 -->
                        <% if (post.excerpt) { %>
                            <%- post.excerpt.length > theme.auto_excerpt.length 
                                ? post.excerpt.substring(0, theme.auto_excerpt.length) + '<span class="excerpt-ellipsis">...</span>' 
                                : post.excerpt %>
                        <% } else { %>
                            没有摘要，要不点进来看看吧 :）
                        <% } %>
                    </p>
                    <div class="flex justify-between items-center">
                        <div class="flex items-center space-x-4">
                            <span class="bg-pixel-blue text-white px-3 py-1 text-sm"><%= post.categories[0] %></span>
                            <span class="text-sm text-note"><%= post.date.format('YYYY-MM-DD') %></span>
                        </div>
                        <a href="<%- url_for(post.path) %>" class="pixel-button">阅读更多</a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>
