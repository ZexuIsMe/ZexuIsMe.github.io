<!-- 分类卡片 -->
<section id="articles" class="pt-16">
    <div class="container mx-auto px-4 py-12">
        <h2 class="text-3xl mb-8 text-shadow">文章分类</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% site.categories.forEach(category => { %>
                <div
                  class="pixel-card p-6 flex items-center hover:scale-105 transition-transform duration-300 cursor-pointer"
                  onclick="handleCategoryCardClick(this)"
                >
                    <div style="display: none" class="w-16 h-16 mr-6 flex items-center justify-center rounded-full bg-pixel-blue bg-opacity-20">
                        <i class="fas fa-folder text-2xl text-pixel-blue"></i>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-xl mb-1"><%= category.name %></h3>
                        <p class="text-sm text-note"><%= category.length %><%= theme.index.category_number %></p>
                    </div>
                    <!-- 查看全部按钮 -->
                    <a href="<%= url_for(category.path) %>"
                        class="pixel-button ml-4"
                        style="display: none;"
                    ><%= theme.index.read_more %></a>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<script>
    function handleCategoryCardClick(card) {
        const a = card.querySelector('a');
        if (!a) {
            console.error("<%= theme.index.now_card_link_404 %>");
            return;
        };
        localStorage.setItem('activeNavLink', a.href);
        a.click();
    }
</script>

<style>
    @media (max-width: 767px) {
        #articles {
            padding-top: 1rem;
        }
        
        #articles .container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }
        
        #articles .text-3xl {
            font-size: 1.5rem;
            margin-bottom: 0.75rem;
        }
        
        #articles .grid {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
        
        #articles .pixel-card {
            padding: 0.75rem;
        }
        
        #articles .text-xl {
            font-size: 1rem;
        }
        
        #articles .text-sm {
            font-size: 0.8125rem;
        }
        
        #articles .gap-6 {
            gap: 0.75rem;
        }
    }
    
    @media (min-width: 768px) and (max-width: 991px) {
        #articles .grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        
        #articles .text-3xl {
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }
        
        #articles .pixel-card {
            padding: 1rem;
        }
    }
    
    @media (min-width: 992px) and (max-width: 1199px) {
        #articles .grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
