<!-- 分类卡片 -->
<section id="articles" class="pt-16">
    <div class="container mx-auto px-4 py-12">
        <h2 class="text-3xl font-bold mb-8 text-pixel-pink text-shadow">文章分类</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% site.categories.forEach(category => { %>
                <div class="pixel-card p-6 flex items-center hover:scale-105 transition-transform duration-300 cursor-pointer" onclick="this.querySelector('a').click()">
                    <div style="display: none" class="w-16 h-16 mr-6 flex items-center justify-center rounded-full bg-pixel-blue bg-opacity-20">
                        <i class="fas fa-folder text-2xl text-pixel-blue"></i>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-xl font-bold mb-1 text-white"><%= category.name %></h3>
                        <p class="text-sm text-note"><%= category.length %> 篇文章</p>
                    </div>
                    <a href="<%- url_for(category.path) %>" class="pixel-button ml-4" style="display: none;">查看全部</a>
                </div>
            <% }); %>
        </div>
    </div>
</section>