<!-- 首页banner -->

<%
    const bannerItems = theme.index.banner;
%>

<section id="home">
    <div class="px-4 py-16" style="width: calc(100vw*0.9); margin: auto;">
        <!-- 轮播容器 -->
        <div class="relative overflow-hidden rounded-lg" id="bannerCarousel" style="height: calc(100vh*0.79); ">
            <!-- 轮播图片 -->
            <div class="flex transition-transform duration-500 ease-in-out h-full" id="carouselTrack">
                <% bannerItems.forEach((item, index) => { %>
                    <div class="w-full flex-shrink-0 h-full">
                        <img 
                            src="<%= url_for(item.image || 'images/bhcyl/banner/0.01.webp') %>" 
                            alt="<%= item.alt || 'Banner ' + (index + 1) %>" 
                            class="w-full h-full object-cover"
                            style="object-position: center top;"
                            onclick="window.location.href = `<%- url_for(item.src || 'index.html') %>`"
                        />
                    </div>
                <% }) %>
                <!-- 添加第一张图片的副本，实现无缝轮播 -->
                <% if (bannerItems.length > 0) { %>
                    <div class="w-full flex-shrink-0 h-full">
                        <img 
                            src="<%= url_for(bannerItems[0].image || 'images/bhcyl/banner/0.01.webp') %>" 
                            alt="<%= bannerItems[0].alt || 'Banner 1' %>" 
                            class="w-full h-full object-cover"
                            style="object-position: center top;"
                        />
                    </div>
                <% } %>
            </div>
            
            <!-- 轮播指示器 -->
            <% if (bannerItems.length > 1) { %>
                <div class="absolute bottom-4 left-0 right-0 flex justify-center space-x-2" id="carouselIndicators">
                    <% bannerItems.forEach((_, index) => { %>
                        <button 
                            class="w-3 h-3 rounded-full bg-white/50 hover:bg-white transition-colors duration-300"
                            data-index="<%= index %>"
                            onclick="goToSlide('<%= index %>')"
                        ></button>
                    <% }) %>
                </div>
            <% } %>
            
            <!-- 轮播控制按钮 -->
            <% if (bannerItems.length > 1) { %>
                <button 
                    class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-10 h-10 rounded-full flex items-center justify-center transition-colors duration-300"
                    onclick="prevSlide()"
                >
                    &larr;
                </button>
                <button 
                    class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-black/30 hover:bg-black/50 text-white w-10 h-10 rounded-full flex items-center justify-center transition-colors duration-300"
                    onclick="nextSlide()"
                >
                    &rarr;
                </button>
            <% } %>
        </div>
    </div>
</section>

<script>
    const bannerItems = JSON.parse('<%- JSON.stringify(bannerItems) %>');
    const totalSlides = bannerItems.length;
    let currentSlide = 0;
    let slideInterval;
    
    function updateCarousel() {
        const track = document.getElementById('carouselTrack');
        const indicators = document.getElementById('carouselIndicators');
        
        if (track) {
            track.style.transform = `translateX(-${currentSlide * 100}%)`;
        }
        
        if (indicators) {
            indicators.querySelectorAll('button').forEach((indicator, index) => {
                if (index === currentSlide % totalSlides) {
                    indicator.classList.add('bg-white');
                    indicator.classList.remove('bg-white/50');
                } else {
                    indicator.classList.remove('bg-white');
                    indicator.classList.add('bg-white/50');
                }
            });
        }
    }
    
    function goToSlide(index) {
        currentSlide = index;
        updateCarousel();
        resetInterval();
    }
    
    function nextSlide() {
        currentSlide++;
        updateCarousel();
        
        // 当轮播到最后一张（副本）时，重置到第一张
        if (currentSlide >= totalSlides) {
            setTimeout(() => {
                currentSlide = 0;
                // 禁用过渡效果，瞬间重置
                const track = document.getElementById('carouselTrack');
                if (track) {
                    track.style.transition = 'none';
                    track.style.transform = `translateX(0%)`;
                    // 重新启用过渡效果
                    setTimeout(() => {
                        track.style.transition = 'transform 500ms ease-in-out';
                    }, 50);
                }
            }, 500);
        }
        
        resetInterval();
    }
    
    function prevSlide() {
        // 当当前是第一张时，先跳转到最后一张的副本
        if (currentSlide === 0) {
            currentSlide = totalSlides;
            const track = document.getElementById('carouselTrack');
            if (track) {
                track.style.transition = 'none';
                track.style.transform = `translateX(-${currentSlide * 100}%)`;
                // 重新启用过渡效果
                setTimeout(() => {
                    track.style.transition = 'transform 500ms ease-in-out';
                    currentSlide--;
                    updateCarousel();
                }, 50);
            }
        } else {
            currentSlide--;
            updateCarousel();
        }
        
        resetInterval();
    }
    
    function startInterval() {
        slideInterval = setInterval(nextSlide, 5000);
    }
    
    function resetInterval() {
        clearInterval(slideInterval);
        startInterval();
    }
    
    // 初始化轮播
    document.addEventListener('DOMContentLoaded', function() {
        if (totalSlides > 1) {
            updateCarousel();
            startInterval();
        }
    });
</script>

<style>
    @media (max-width: 767px) {
        #home .px-4 {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        
        #home .py-16 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        
        #bannerCarousel {
            height: calc(100vh * 0.25) !important;
        }
        
        #carouselIndicators button {
            width: 0.5rem;
            height: 0.5rem;
        }
        
        #bannerCarousel button {
            width: 2rem;
            height: 2rem;
            font-size: 1rem;
        }
    }
    
    @media (min-width: 768px) and (max-width: 991px) {
        #bannerCarousel {
            height: calc(100vh * 0.4) !important;
        }
    }
    
    @media (min-width: 992px) and (max-width: 1199px) {
        #bannerCarousel {
            height: calc(100vh * 0.5) !important;
        }
    }
</style>