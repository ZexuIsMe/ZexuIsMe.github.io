<!-- 最新文章 -->
<section id="post-lasted">
    <div class="container mx-auto px-4">
        <!-- 最新文章列表 -->
        <h2 class="text-3xl mb-8 text-shadow"><%= theme.index.latest_posts %></h2>
        <div class="grid grid-cols-1 gap-8">
            <% site.posts.sort('date', -1).slice(0, 3).forEach((post, index) => { %>
                <div class="pixel-card p-6">
                    <!-- 文章标题 -->
                    <h3 class="mb-4 truncate" title="<%= post.title %>"><%= post.title %></h3>
                    <!-- 文章摘要 -->
                     <div class="excerpt">
                        <% if (post.excerpt) { %>
                            <%- post.excerpt %>
                        <% } else { %>
                            <%- markdown(theme.index.no_excerpt) %>
                        <% } %>
                     </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-note"><%= post.date.format('YYYY-MM-DD') %></span>
                        <!-- 阅读更多按钮 -->
                        <a href="<%- url_for(post.path) %>" class="pixel-button"><%= theme.index.read_more %></a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<style>
    @media (max-width: 767px) {
        #post-lasted .container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        
        #post-lasted .text-3xl {
            font-size: 1.5rem;
            margin-bottom: 0.75rem;
        }
        
        #post-lasted .pixel-card {
            padding: 0.75rem;
        }
        
        #post-lasted .mb-4 {
            margin-bottom: 0.5rem;
        }
        
        #post-lasted .excerpt {
            font-size: 0.9375rem;
            line-height: 1.5;
            margin-bottom: 0.75rem;
        }
        
        #post-lasted .text-sm {
            font-size: 0.8125rem;
        }
        
        #post-lasted .pixel-button {
            padding: 0.5rem 0.875rem;
            font-size: 0.6875rem;
        }
        
        #post-lasted .gap-8 {
            gap: 1rem;
        }
    }
    
    @media (min-width: 768px) and (max-width: 991px) {
        #post-lasted .text-3xl {
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }
        
        #post-lasted .pixel-card {
            padding: 1rem;
        }
    }
</style>