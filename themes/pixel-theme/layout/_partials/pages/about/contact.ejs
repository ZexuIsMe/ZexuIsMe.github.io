<section id="contact">
    <div class="container mx-auto px-4 py-12">
        <h4 class="text-3xl font-bold mb-8 text-pixel-pink text-shadow">联系我</h2>
    </div>
    <div class="container mx-auto px-4 mb-12">
        <div class="flex flex-col md:flex-row gap-8">
            <div class="md:w-4/12 flex flex-col gap-8">
                <div>
                    <p class="text-lg"><span class="font-bold">TapTap：</span>43433339</p>
                    <p class="text-lg"><span class="font-bold">微信：</span><%= theme.vx.id %></p>
                    <p class="text-lg"><span class="font-bold">抖音：</span><%= theme.tiktok.id %></p>
                    <p class="text-lg"><span class="font-bold">邮箱：</span><%= theme.email['126'] %></p>
                    <p class="text-lg"><span class="font-bold" style="visibility: hidden;">邮箱：</span><%= theme.email['qq'] %></p>
                </div>
            </div>

            <div class="md:w-4/12 flex flex-col gap-8">
                <!-- <img src="<%= url_for('/images/ZC__2091.JPG') %>" alt="Contact Me" class="h-64 mx-auto pixel-art pixel-border contact-image cursor-pointer"> -->
            </div>
            <div class="md:w-4/12 flex flex-col gap-8">
                <img src="<%= theme.vx.image %>" alt="Contact Me" class="h-64 mx-auto pixel-art pixel-border contact-image cursor-pointer">
            </div>
        </div>
    </div>
</section>

<!-- 图片放大模态框 -->
<div id="image-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <div class="absolute inset-0 bg-black bg-opacity-80 modal-overlay"></div>
    <div class="relative bg-white p-4 rounded-lg max-w-4xl max-h-[90vh] w-full mx-4 flex items-center justify-center modal-content">
        <img id="modal-image" src="" alt="放大图片" class="max-w-full max-h-[85vh] object-contain pixel-art">
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('image-modal');
        const modalContent = document.querySelector('.modal-content');
        const modalOverlay = document.querySelector('.modal-overlay');
        const modalImage = document.getElementById('modal-image');
        const contactImages = document.querySelectorAll('.contact-image');
        
        // 打开模态框
        contactImages.forEach(image => {
            image.addEventListener('click', function() {
                modalImage.src = this.src;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            });
        });
        
        // 关闭模态框
        function closeModal() {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
        
        // 点击遮罩关闭
        modalOverlay.addEventListener('click', closeModal);
        
        // 点击内容区域关闭
        modalContent.addEventListener('click', closeModal);
    });
</script>

<style>
    .contact-image {
        transition: transform 0.2s ease;
    }
    
    .contact-image:hover {
        transform: scale(1.05);
    }
    
    .modal-content {
        transition: all 0.2s ease-in-out;
    }
    
    .modal-overlay {
        transition: all 0.2s ease-in-out;
    }
</style>