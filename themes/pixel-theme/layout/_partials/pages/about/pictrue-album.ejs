<!-- 关于我的图片相册 - 瀑布流布局 -->
<%
    const items = theme.about.pictures
%>
<section id="my-picture"> 
    <div class="container mx-auto py-8">
        <h2 class="text-3xl font-bold text-center mb-8">我的图片相册</h2>
        
        <!-- 瀑布流容器 -->
        <div class="masonry-container" id="masonry-grid">
            <% items.forEach(picture => { %>
                <% picture.images.forEach(image => { %>
                    <!-- 图片项 -->
                    <div class="masonry-item">
                        <div class="masonry-content">
                            <img 
                                src="<%- cosImage(image, {quality: 50}) %>" 
                                alt="<%= picture.name %>" 
                                class="masonry-image pixel-art pixel-border" 
                                loading="lazy"
                                style="cursor: pointer;"
                            >
                            <div class="masonry-overlay">
                                <div class="masonry-caption"><%= picture.name %></div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% }) %>
        </div>
    </div>
</section>

<!-- 图片预览模态框 -->
<div class="modal" id="imageModal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <img class="modal-image" id="modalImage">
        <div class="modal-caption" id="modalCaption"></div>
    </div>
</div>

<script>
    // 页面加载完成后执行
    document.addEventListener('DOMContentLoaded', function() {
        // 初始化瀑布流
        initMasonry();
        
        // 初始化图片预览功能
        initImagePreview();
        
        // 初始化懒加载
        initLazyLoading();
    });
    
    // 初始化瀑布流
    function initMasonry() {
        // 监听窗口大小变化，调整瀑布流
        window.addEventListener('resize', function() {
            // 简单的瀑布流实现，使用CSS column-count
            // 当窗口大小改变时，CSS媒体查询会自动调整列数
        });
    }
    
    // 初始化图片预览功能
    function initImagePreview() {
        const modal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');
        const modalCaption = document.getElementById('modalCaption');
        const closeBtn = document.querySelector('.close');
        const masonryItems = document.querySelectorAll('.masonry-content');
        
        // 为每个图片项添加点击事件
        masonryItems.forEach(function(item) {
            item.addEventListener('click', function() {
                const img = this.querySelector('.masonry-image');
                const caption = this.querySelector('.masonry-caption').textContent;
                
                // 设置模态框内容
                modalImage.src = img.src;
                modalImage.alt = img.alt;
                modalCaption.textContent = caption;
                
                // 显示模态框
                modal.classList.add('show');
                
                // 阻止页面滚动
                document.body.style.overflow = 'hidden';
            });
        });
        
        // 关闭模态框
        function closeModal() {
            modal.classList.remove('show');
            document.body.style.overflow = '';
        }
        
        // 点击关闭按钮
        closeBtn.addEventListener('click', closeModal);
        
        // 点击非图片区域关闭
        modal.addEventListener('click', function(event) {
            const modalImage = document.getElementById('modalImage');
            if (event.target !== modalImage) {
                closeModal();
            }
        });
        
        // 按ESC键关闭模态框
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape' && modal.classList.contains('show')) {
                closeModal();
            }
        });
    }
    
    // 初始化懒加载
    function initLazyLoading() {
        // 使用原生的loading="lazy"属性
        // 这里可以添加额外的懒加载逻辑，如自定义占位符等
        const lazyImages = document.querySelectorAll('img[loading="lazy"]');
        
        if ('IntersectionObserver' in window) {
            const imageObserver = new IntersectionObserver(function(entries, observer) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        img.classList.add('fade-in');
                        imageObserver.unobserve(img);
                    }
                });
            });
            
            lazyImages.forEach(function(img) {
                imageObserver.observe(img);
            });
        }
    }
    
    // 添加图片加载动画
    document.addEventListener('DOMContentLoaded', function() {
        const images = document.querySelectorAll('.masonry-image');
        
        images.forEach(function(img) {
            img.addEventListener('load', function() {
                this.classList.add('loaded');
                // 为父容器添加loaded类，隐藏占位符
                const container = this.closest('.masonry-content');
                if (container) {
                    container.classList.add('loaded');
                }
            });
            
            // 如果图片已经加载完成
            if (img.complete) {
                img.classList.add('loaded');
                // 为父容器添加loaded类，隐藏占位符
                const container = this.closest('.masonry-content');
                if (container) {
                    container.classList.add('loaded');
                }
            }
        });
    });
    
    // 添加滚动动画效果
    function handleScrollAnimation() {
        const masonryContainer = document.getElementById('masonry-grid');
        const rect = masonryContainer.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        if (rect.top < windowHeight * 0.8 && rect.bottom > 0) {
            masonryContainer.classList.add('animate-in');
        }
    }
    
    // 监听滚动事件
    window.addEventListener('scroll', handleScrollAnimation);
    
    // 初始检查
    window.addEventListener('load', handleScrollAnimation);
</script>

<style>
    /* 瀑布流布局样式 */
    .masonry-container {
        column-count: 1;
        column-gap: 1rem;
        width: 100%;
    }
    
    @media (min-width: 640px) {
        .masonry-container {
            column-count: 2;
        }
    }
    
    @media (min-width: 768px) {
        .masonry-container {
            column-count: 3;
        }
    }
    
    @media (min-width: 1024px) {
        .masonry-container {
            column-count: 4;
        }
    }
    
    @media (min-width: 1280px) {
        .masonry-container {
            column-count: 5;
        }
    }
    
    /* 瀑布流项样式 */
    .masonry-item {
        break-inside: avoid;
        margin-bottom: 1rem;
        position: relative;
    }
    
    .masonry-content {
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }
    
    .masonry-content:hover {
        transform: translateY(-5px);
    }
    
    .masonry-image {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.5s ease;
    }
    
    .masonry-content:hover .masonry-image {
        transform: scale(1.05);
    }
    
    /* 图片悬停遮罩效果 */
    .masonry-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .masonry-content:hover .masonry-overlay {
        opacity: 1;
    }
    
    .masonry-caption {
        color: white;
        padding: 1rem;
        text-align: center;
        font-size: 1rem;
        font-weight: 500;
    }
    
    /* 模态框样式 */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: rgba(0, 0, 0, 0.9);
        align-items: center;
        justify-content: center;
    }
    
    .modal-content {
        position: relative;
        margin: 0;
        padding: 0;
        width: 90%;
        max-width: 1200px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        max-height: 90vh;
    }
    
    .close {
        position: absolute;
        top: -40px;
        right: 0;
        color: white;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        z-index: 10;
    }
    
    .close:hover,
    .close:focus {
        color: #bbb;
        text-decoration: none;
        cursor: pointer;
    }
    
    .modal-image {
        max-width: 100%;
        max-height: 80vh;
        border-radius: 8px;
    }
    
    .modal-caption {
        color: white;
        padding: 1rem;
        font-size: 1.2rem;
    }
    
    /* 动画效果 */
    @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }
    
    .modal.show {
        display: flex;
        animation: fadeIn 0.3s ease;
    }
    
    /* 响应式调整 */
    @media (max-width: 640px) {
        .modal-content {
            margin: 10% auto;
            width: 95%;
        }
        
        .modal-image {
            max-height: 70vh;
        }
    }
    /* 图片加载动画 */
    .masonry-image {
        opacity: 0;
        transition: opacity 0.5s ease;
        background-color: #f0f0f0;
        min-height: 200px;
    }
    
    .masonry-image.loaded {
        opacity: 1;
        background-color: transparent;
    }
    
    /* 图片淡入动画 */
    .masonry-image.fade-in {
        animation: fadeIn 0.5s ease;
    }
    
    /* 占位符样式 */
    .masonry-content {
        background-color: #f0f0f0;
        position: relative;
    }
    
    .masonry-content::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 40px;
        height: 40px;
        border: 3px solid #ccc;
        border-radius: 50%;
        border-top-color: #333;
        animation: spin 1s ease-in-out infinite;
        z-index: 1;
    }
    
    .masonry-content.loaded::before {
        display: none;
    }
    
    /* 加载动画 */
    @keyframes spin {
        to { transform: translate(-50%, -50%) rotate(360deg); }
    }
    
    /* 滚动动画 */
    .masonry-container {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.8s ease, transform 0.8s ease;
    }
    
    .masonry-container.animate-in {
        opacity: 1;
        transform: translateY(0);
    }
</style>