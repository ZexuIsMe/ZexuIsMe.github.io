<!-- 关于我 -->
<%
    const myDescItems = [
        '大家好呀～ 我是 [粥记捣蛋]，一个热爱游戏，还总忍不住记录些什么的 “随笔爱好者”。​',
        '日常要么在虚拟世界闯关探宝，研究角色构筑，块拼凑心中的小天地。',
        '而 “记录” 早已成为我的习惯 —— 游戏里灵光一闪的构筑思路、通关后的感悟随笔，生活中踩过的坑、工作里沉淀的实用经验，都想一一写下来留存。​',
        '如果你也愿意在文字里交换心事，欢迎常来坐坐～ 期待在这里认识更多温暖有趣的灵魂，一起在时光里慢慢沉淀，慢慢成长。'
    ]
%>
<div class="min-h-screen pt-16 bg-dark">
    <section id="aboutMe">
        <div class="container mx-auto px-4 py-12">
            <% if (!page.path.includes('about')) { %>
                <h2 class="text-3xl font-bold mb-8 text-pixel-pink text-shadow">关于我</h2>
            <% } %>

            <div class="flex flex-col md:flex-row items-center mb-12">
                <div class="md:w-1/3 mb-6 md:mb-0">
<!--                    <img src="<%= theme['logo'] %>" alt="About Me" class="w-64 h-64 mx-auto pixel-art pixel-border">-->
                    <video src="<%= url_for('/images/呼吸动画.mp4') %>" autoplay 
  muted 
  loop 
  controls></video>
                </div>
                <div class="md:w-2/3 md:pl-12">
                    <h3 class="text-2xl font-bold mb-4 text-pixel-blue">Undefined</h3>
                    <div id="my-desc-container">
                        <% myDescItems.forEach(item => { %>
                            <p class="mb-4 text-lg leading-relaxed"><%= item %></p>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
