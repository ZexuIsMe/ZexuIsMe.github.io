<nav class="nav-bg shadow-lg sticky top-0 z-50">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center py-4">
            <div class="flex items-center space-x-4">
                <img src="https://p3-flow-imagex-sign.byteimg.com/tos-cn-i-a9rns2rl98/rc/pc/super_tool/045d52041e0640dbba5b55b00bcffd70~tplv-a9rns2rl98-image.image?lk3s=8e244e95&rcl=20260202192528FF625BE2146F4D36E478&rrcfp=f06b921b&x-expires=1772623642&x-signature=tTj5R5wpKcuVun%2BC4uGNbeXo1bc%3D" alt="Logo" class="w-12 h-12 pixel-art pixel-border">
                <span class="nav-title text-2xl font-bold text-white text-shadow-pixel"><%= config.title %></span>
            </div>
            <div id="menu" class="hidden md:flex space-x-8">
                <a href="<%= url_for('index') %>" class="nav-link active text-white hover:text-pixel-pink text-lg">首页</a>
                <a href="<%= url_for('archives') %>" class="nav-link text-white hover:text-pixel-pink text-lg">归档</a>
                <a href="<%= url_for('about') %>" class="nav-link text-white hover:text-pixel-pink text-lg">关于我</a>
            </div>
            <div class="md:hidden">
                <button id="mobile-menu-button" class="text-text">
                    <i class="fa fa-bars text-2xl"></i>
                </button>
            </div>
        </div>
        <div id="mobile-menu" class="md:hidden hidden pb-4">
            <a href="<%= url_for('index') %>" class="block py-2 text-white hover:text-pixel-pink">首页</a>
            <a href="<%= url_for('archives') %>" class="block py-2 text-white hover:text-pixel-pink">归档</a>
            <a href="<%= url_for('about') %>" class="block py-2 text-white hover:text-pixel-pink">关于我</a>
        </div>
    </div>
</nav>

<script>
// 导航栏功能初始化
(function() {
    // 获取导航链接元素
    var navLinks = document.querySelectorAll('.nav-link');
    var mobileLinks = document.querySelectorAll('#mobile-menu a');
    const STORAGE_KEY = 'activeNavLink';

    /**
     * 设置激活的链接
     * @param {HTMLElement} clickedLink - 被点击的链接元素
     * @param {NodeList} allLinks - 所有链接元素列表
     */
    function setActiveLink(clickedLink, allLinks) {
        // 移除所有链接的 active 类
        allLinks.forEach(function(link) {
            link.classList.remove('active');
        });
        // 为被点击的链接添加 active 类
        clickedLink.classList.add('active');
    }

    /**
     * 从本地存储初始化激活的链接
     */
    function initActiveLinkFromStorage() {
        var storedLink = localStorage.getItem(STORAGE_KEY);
        if (storedLink) {
            // 为桌面端导航链接设置激活状态
            navLinks.forEach(function(link) {
                if (link.getAttribute('href') === storedLink) {
                    setActiveLink(link, navLinks);
                }
            });
            // 为移动端导航链接设置激活状态
            mobileLinks.forEach(function(link) {
                if (link.getAttribute('href') === storedLink) {
                    setActiveLink(link, mobileLinks);
                }
            });
        } else {
            // 默认选中首页
            navLinks.forEach(function(link) {
                if (link.textContent === '首页') {
                    setActiveLink(link, navLinks);
                }
            });
            mobileLinks.forEach(function(link) {
                if (link.textContent === '首页') {
                    setActiveLink(link, mobileLinks);
                }
            });
        }
    }

    // 为桌面端导航链接添加点击事件监听
    navLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            var href = this.getAttribute('href');
            // 存储选中的链接到本地存储
            localStorage.setItem(STORAGE_KEY, href);
            setActiveLink(this, navLinks); // 更新激活状态
        });
    });

    // 为移动端导航链接添加点击事件监听
    mobileLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            var href = this.getAttribute('href');
            // 存储选中的链接到本地存储
            localStorage.setItem(STORAGE_KEY, href);
            setActiveLink(this, mobileLinks); // 更新激活状态
        });
    });

    // 页面加载时初始化激活的链接
    initActiveLinkFromStorage();
})();
</script>