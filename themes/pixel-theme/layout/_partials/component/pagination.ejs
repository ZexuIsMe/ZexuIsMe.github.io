<% if (page && page.total > 1) { %>
    <div class="pagination flex justify-between items-center mt-8">
        <!-- 上一页按钮 -->
        <div class="pagination-prev">
            <% if (page.current === 1) { %>
                <button class="pixel-button cursor-not-allowed opacity-50" disabled>
                    <i class="fa fa-arrow-left mr-2"></i> 上一页
                </button>
            <% } else { %>
                <a href="<%= url_for(page.prev_link) %>" class="pixel-button hover:bg-secondary transition-colors">
                    <i class="fa fa-arrow-left mr-2"></i> 上一页
                </a>
            <% } %>
        </div>
        
        <!-- 页码信息 -->
        <div class="pagination-info text-primary-text">
            当前 <%= page.current %> 页 / 共 <%= page.total %> 页
        </div>
        
        <!-- 下一页按钮 -->
        <div class="pagination-next">
            <% if (page.current === page.total) { %>
                <button class="pixel-button cursor-not-allowed opacity-50" disabled>
                    下一页 <i class="fa fa-arrow-right ml-2"></i>
                </button>
            <% } else { %>
                <a href="<%= url_for(page.next_link) %>" class="pixel-button hover:bg-secondary transition-colors">
                    下一页 <i class="fa fa-arrow-right ml-2"></i>
                </a>
            <% } %>
        </div>
    </div>
<% } %>
