<% if (page && page.total > 1) { %>
    <div class="pagination flex justify-between items-center mt-8">
        <!-- 上一页按钮 -->
        <div class="pagination-prev">
            <% if (page.current === 1) { %>
                <button class="px-4 py-2 bg-secondary text-secondary-text rounded cursor-not-allowed" disabled>
                    上一页
                </button>
            <% } else { %>
                <a href="<%= url_for(page.prev_link) %>" class="px-4 py-2 bg-primary text-primary-text rounded hover:bg-tertiary transition-colors">
                    上一页
                </a>
            <% } %>
        </div>
        
        <!-- 页码信息 -->
        <div class="pagination-info text-primary-text">
            当前 <%= page.current %> 页 / 共 <%= page.total %> 页
        </div>
        
        <!-- 下一页按钮 -->
        <div class="pagination-next">
            <% if (page.current === page.total) { %>
                <button class="px-4 py-2 bg-secondary text-secondary-text rounded cursor-not-allowed" disabled>
                    下一页
                </button>
            <% } else { %>
                <a href="<%= url_for(page.next_link) %>" class="px-4 py-2 bg-primary text-primary-text rounded hover:bg-tertiary transition-colors">
                    下一页
                </a>
            <% } %>
        </div>
    </div>
<% } %>
