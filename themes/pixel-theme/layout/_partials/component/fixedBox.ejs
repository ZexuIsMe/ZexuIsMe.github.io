<section class="fixed-box fixed bottom-8 right-8 z-50">
    <div class="relative">
        <button id="back-to-top" class="bg-black text-white w-12 h-12 rounded-full flex items-center justify-center shadow-lg opacity-0 invisible transition-all duration-300">
            <i class="fas fa-arrow-up text-xl"></i>
        </button>
        <span class="tooltip absolute top-[-40px] left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs px-3 py-2 rounded opacity-0 invisible transition-all duration-300 whitespace-nowrap">
            回到顶部
        </span>
    </div>
</section>

<script>
    (function() {
        let backToTopButton = document.getElementById('back-to-top');
        let backToTopTooltip = backToTopButton ? backToTopButton.nextElementSibling : null;
        
        let tooltipTimers = {};

        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                backToTopButton.classList.remove('opacity-0', 'invisible');
                backToTopButton.classList.add('opacity-100', 'visible');
            } else {
                backToTopButton.classList.remove('opacity-100', 'visible');
                backToTopButton.classList.add('opacity-0', 'invisible');
                
                if (backToTopTooltip) {
                    backToTopTooltip.classList.remove('opacity-100', 'visible');
                    backToTopTooltip.classList.add('opacity-0', 'invisible');
                }
            }
        });

        backToTopButton.addEventListener('click', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
        
        function showTooltip(tooltip, buttonId) {
            if (tooltipTimers[buttonId]) {
                clearTimeout(tooltipTimers[buttonId]);
            }
            
            tooltip.classList.remove('opacity-0', 'invisible');
            tooltip.classList.add('opacity-100', 'visible');
            
            tooltipTimers[buttonId] = setTimeout(function() {
                hideTooltip(tooltip);
            }, 3000);
        }
        
        function hideTooltip(tooltip) {
            tooltip.classList.remove('opacity-100', 'visible');
            tooltip.classList.add('opacity-0', 'invisible');
        }
        
        if (backToTopButton && backToTopTooltip) {
            backToTopButton.addEventListener('mouseenter', function() {
                if (backToTopButton.classList.contains('visible')) {
                    showTooltip(backToTopTooltip, 'back-to-top');
                }
            });
            
            backToTopButton.addEventListener('mouseleave', function() {
                hideTooltip(backToTopTooltip);
            });
        }
    })();
</script>

<style>
    .tooltip {
        pointer-events: none;
    }
    
    .tooltip::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border-width: 5px;
        border-style: solid;
        border-color: transparent transparent transparent transparent;
    }
</style>