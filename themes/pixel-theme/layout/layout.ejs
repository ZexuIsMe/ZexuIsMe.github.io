<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.title %></title>

    <%- js(['/js/tailwindcss_3.4.17.js', '/js/pixel-theme.js']) %>
    <%- css([
        '/css/layout.css',
        '/css/atom-one-dark.min.css'
    ]) %>


    <link href="<%- url_for('/css/pixel-theme.css') %>" rel="stylesheet" type="text/tailwindcss">

    <!-- 引入必要的JS -->
    <script>
        var useGlobalLink = (href) => {
            const globalLink = document.getElementById('global-link');
            globalLink.href = href;
            if (!href) {
                console.error("缺少必要的 href 参数");
                return;
            }
            globalLink.click();
        };
    </script>
</head>

<body class="scanline">
    <% /* 非404和非bhcyl页面显示完整布局 */ %>
    <% if (page.layout !== '404') { %>
        <!-- 导航栏组件 -->
        <%- partial('_partials/component/nav') %>

        <!-- 主内容区域 -->
        <main>
            <!-- 全局点击调用链接 -->
            <a id="global-link" href="#" style="display: none;">全局点击调用时可用</a>
            <!-- 页面主体内容 -->
            <%- body %>
        </main>
        <!-- 固定到顶部按钮和主题切换按钮 -->
        <%- partial('_partials/component/fixedBox') %>
    <% } else { %>
        <!-- 404页面只显示主体内容 -->
        <%- body %>
    <% } %>
    
    <% /* 非404页面加载主脚本 */ %>
    <% if (page.layout !== '404') { %>
        <!-- defer属性使脚本在HTML解析完成后执行，提高页面加载性能 -->
        <script src="<%- url_for('/js/main.js') %>" defer></script>
    <% } %>

    <!-- 页脚组件 -->
    <%- partial('footer') %>

</body>
</html>