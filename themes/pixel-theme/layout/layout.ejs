<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.title %></title>
    <%- js([
        '/js/tailwindcss_3.4.17.js', 
        '/js/pixel-theme.js',
    ]) %>
    <%- css([
        '/css/layout.css',
        '/css/excerpt.css',
        '/css/atom-one-dark.min.css'
    ]) %>
    <link href="<%- url_for('/css/pixel-theme.css') %>" rel="stylesheet" type="text/tailwindcss">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

</head>
<body class="scanline light-mode">
    <% if (page.layout !== '404') { %>
        <%- partial('_partials/component/nav') %>

        <main>
            <a id="global-link" href="" style="display: none;">全局点击调用时可用</a>
            <%- body %>
        </main>

        <%- partial('_partials/footer') %>

        <!-- 固定到顶部按钮和主题切换按钮 -->
        <%- partial('_partials/component/fixedBox') %>

        <script src="<%- url_for('/js/main.js') %>"></script>
    <% } else { %>
        <%- body %>
    <% } %>
</body>
</html>