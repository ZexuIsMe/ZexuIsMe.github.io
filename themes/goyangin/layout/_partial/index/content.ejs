<%
    const categoriesList = list_categories({
        depth: 1,
        class: "",
        show_count: true,
        order: -1,
        orderby: 'length'
    })
    // console.log(site.categories)
%>
<div id="home-post-list">
    <div class="container p-4" style="display: none">
        <section>
            <!-- title -->
            <%- partial('_partial/section-title', { item: { name: 'Markdown', icon: 'fab fa-markdown' } }) %>
            <!-- content -->
            <div class="d-flex flex-wrap" style="row-gap: 1rem">
                <% page.posts.each(item => { %>
                    <%- partial('_partial/post-card', { item: item }) %>
                <% }) %>
            </div>
        </section>
        <!-- section：分页信息 -->
        <%- partial('_partial/pagination') %>
    </div>

    <div class="container p-4">
        <!-- title -->
        <%- partial('_partial/section-title', { item: { name: 'Markdown Card', icon: 'fab fa-markdown' } }) %>
        <div class="list-categories">
            <%- categoriesList %>
        </div>
    </div>
</div>