

<!-- 获取文章列表 -->
<div class="columns is-multiline">
    <% page.posts.each(function(item){ %>
        <div class="column modify-home-post-column">
            <%- partial('article-excerpt', {item: item}) %>
        </div>
    <% }); %>
</div>

<% if( 1 === 0 ) {%>
    <!-- 初始化分页所需的参数 -->
    <% var last, postCount = 0; %>
    <!-- 获取文章列表 -->
    <% page.posts.each(function(item){ %>
        <!-- 循环记录文章的数量 -->
        <% postCount++; %>
        <!-- 添加行，文章数和网格布局的参数两者取余，如果是1，表示是这一行的第一个 -->
        <% if(postCount % theme.grid == 1) {%>
            <!-- 如果是这一行的第一个，创建一个 div  -->
            <div class="columns"> <!-- 2 -->
        <% } %>

            <%- partial('article-excerpt', {item: item}) %>
        <!-- 标签闭合：如果是这一行的最后一个，则添加闭合标签div -->
        <% if( postCount == page.posts.length || postCount % theme.grid == 0) {%>
            </div> <!-- This will work as expected -->
        <% } %>
    <% }); %>
<% } %>

 <%- partial('pagination', {type: 'page'}) %>

 