<div style="height: 10rem"></div>
<section style="width: 100%; height: 20rem; background-color: var(--grey-100)">
    <div class="container d-flex align-center px-4" style="height: 100%; color: var(--grey-500)">
        <div style="line-height: 2">
            <!-- config.yml footer -->
            <% theme.footer.forEach((item, index) => { %>
                <div>
                    <span>【<%= item.title %>】<%= item.content %></span>
                    <% if (!!item.url) { %>
                        <sup>
                            <a href="<%= item.url %>">[<%= index+1 %>]</a>
                        </sup>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>
</section>