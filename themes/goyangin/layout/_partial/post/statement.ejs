<!-- 文章的声明 -->
<div id="copy-icon-<%= item.title %>" style="word-wrap: break-word">
    <p>
        <strong>作者</strong>：
        <span>粥记捣蛋</span>
    </p>
    <p>
        <strong>文章链接</strong>：
        <span
                id="article-link-span"
                data-text="<%= item.permalink %>"
        ></span>
    </p>
    <p>
        <strong>版权声明</strong>：
        <span>本网站所有文章除特别声明外,均采用 CC BY-NC 4.0 许可协议。转载请注明出处!</span>
    </p>
</div>

<script>
    console.log(document.getElementById("article-link-span"))
    const linkDOM = document.getElementById("article-link-span")
    if (linkDOM) {
        let linkText = linkDOM.getAttribute("data-text")
        linkDOM.innerHTML = `<a href="${linkText}" target="_blank">${ decodeURI(linkText)}</a>`
    }
</script>