<!-- 渲染：阅读整篇文章 -->
<style>
    #read-post {
        min-height: calc(100% - 210px);
        max-width: 85%;
        margin: auto;
    }

    @media (max-width: 768px) {
        #read-post {
            max-width: 85%;
        }
    }
</style>

<% const postDOMId = 'read-post' %>

<div style="height: 80px"></div>

<article id="<%= postDOMId %>">
    <!-- Title -->
    <div class="level">
        <div class="level-left">
            <div class="media">
                <div class="media-content">
                    <h1 class="title is-4 modify-post-title">
                        <span class="has-text-info"><%- item.title || '标题缺失，务必添加 Title' %></span>
                    </h1>
                    <p class="subtitle is-6">
                        <span class="icon is-small"><i class="far fa-user"></i></span> <%- item.author ? item.author : config.author  %>
                        <span class="icon is-small"><i class="far fa-clock"></i></span> <%= item.updated.format('YYYY-MM-DD HH:mm') %>
                    </p>
                </div>
            </div>
        </div>
        <!-- 文章标签 -->
        <div class="pt-4">
            <span><%- partial('post/article-tags', {item: item}) %></span>
            <span><%- partial('post/post-categories', {item: item}) %></span>
        </div>
    </div>

    <!-- 目录  -->
    <div><%- toc(item.content, {
            list_number: true,
            max_depth: 3
        }) %></div>
    <!-- 文章：内容 -->
    <div class="content pb-3" style="line-height: 2.86rem; font-size: 1.125rem">
        <hr />
        <!-- Content -->
        <%- item.content %>
    </div>
    <!-- 文章：声明 -->
    <%- partial('post/statement.ejs') %>
    <!-- 文章：文章切换 -->
    <div style="margin-top: 48px"><%- partial('post/toggle.ejs') %></div>

</article>

<div style="height: 80px"></div>

<script>
    class PostEjs extends Blog{
        constructor() {
            super();
        }
    }
    const postEjs = new PostEjs();
</script>