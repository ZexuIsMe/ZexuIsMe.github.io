<div class="card">
    <!-- Title -->
    <header class="card-header">
        <p class="card-header-title">
            <a href="<%- config.root %><%- item.path %>"> <span class="has-text-info"> <%- item.title %>  </span>
            </a>
        </p>
        <span class="card-header-icon">
           <%= item.date.format(config.date_format) %>
        </span>
    </header>

    <!--    <div class="card-image">-->
    <!--        <figure class="image is-2by1">-->

    <!--        <% if (item.thumbs){ %>-->
    <!--            <img src="<%- item.thumbs %>" alt="Image">-->
    <!--        <% }else{ %>-->
    <!--            <img src="<%= theme.thumbimg %>/id/<%- Math.ceil(Math.random() * 999) %>/500/260" alt="Image">-->
    <!--        <% } %>-->

    <!--        </figure>-->
    <!--    </div>-->

    <!-- Content -->
    <div class="card-content modify-card-overflow">
        <div class="content">
            <!-- Content -->
            <%- item.content %>
            <hr/>
        </div>
        <!--        <%- truncate(strip_html(item.content), {
            length: 160,
            omission: '...'
        }) || truncate(z, {length: 160, omission: '...'}) %>-->
    </div>

    <!-- footer: 首页文章 Card,底部内容 -->
    <div class="ifoot">
        <!-- 文章标签  TODO 标签溢出后的操作 -->
        <% if (item.tags && item.tags.length){ %>
            <% item.tags.forEach(function (tag) { %>
                <a href="<%= url_for(tag.path) %>">
                    <span class="tag is-info">
                        <span class="icon is-small">
                            <i class="fa fa-tag"></i>&nbsp;</span><%= tag.name %>
                    </span>
                </a>
            <% }) %>
        <% } %>
        <!-- Read More：阅读更多 -->
        <div class="is-pulled-right">
            <a href="<%- config.root %><%- item.path %>" class="button is-info is-small is-outlined">
                <%= theme.excerpt_link %>
            </a>
        </div>
    </div>


</div>
